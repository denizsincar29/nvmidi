// octave-doubler.nvgt - keyboard in, synth out, every note an octave higher.
// Escape stops. The switch is a router: one message in, one place out.

#include "../midi.nvgt"

midi_input@ input;
midi_output@ output;
midi_message m;

int pitched(int note) {
	int up = note + 12;
	if (up > 127) up -= 12; // wrap rather than go silent at the top
	return up;
}

void main() {
	show_window("nvmidi - keyboard to synth");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@input = midi_input_create();
	@output = midi_output_create();
	if (!input.open_config(config, "nvmidi forward in")) {
		print("Cannot open the input: " + midi_last_error_text() + "\n");
		return;
	}
	if (!output.open_config(config, "nvmidi forward out")) {
		print("Cannot open the output: " + midi_last_error_text() + "\n");
		input.close();
		return;
	}

	while (!key_pressed(KEY_ESCAPE)) {
		while (input.next_message(m)) {
			switch (m.kind) {
			case MIDI_NOTE_ON:
				if (m.is_note_off) output.send_note_off(m.channel, pitched(m.data1), 0);
				else output.send_note_on(m.channel, pitched(m.data1), m.data2);
				break;
			case MIDI_NOTE_OFF:
				output.send_note_off(m.channel, pitched(m.data1), m.data2);
				break;
			case MIDI_CONTROL_CHANGE:
			case MIDI_PITCH_BEND:
				output.send(m.status, m.data1, m.data2); // unchanged, so forward as-is
				break;
			}
		}
		wait(5);
	}

	output.all_notes_off(); // never leave a note sounding
	output.close();
	input.close();
}
