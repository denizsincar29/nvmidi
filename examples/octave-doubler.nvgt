// octave-doubler.nvgt - play a keyboard through a synth on the same computer:
// every note arrives on the input port and leaves through the output port, an
// octave higher. Escape stops.
//
// The handles are file scope globals and are assigned inside main(), not where
// they are declared: a script global is initialised before the plugin has
// registered its types, so a handle created there is not the one main() gets.

#include "../midi.nvgt"

midi_input@ input;
midi_output@ output;
midi_message m;

// The one note the whole example is about: an octave up, wrapped back rather
// than pushed past 127, so the top octave doubles down instead of going silent.
int pitched(int note) {
	int up = note + 12;
	if (up > 127) up -= 12;
	return up;
}

void main() {
	show_window("nvmidi - keyboard to synth");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@input = midi_input_create();
	@output = midi_output_create();
	if (!input.open_config(config, "nvmidi forward in")) {
		print("Cannot open the input: " + midi_last_error_text() + "\n");
		return;
	}
	if (!output.open_config(config, "nvmidi forward out")) {
		print("Cannot open the output: " + midi_last_error_text() + "\n");
		input.close();
		return;
	}

	while (!key_pressed(KEY_ESCAPE)) {
		while (input.next_message(m)) {
			// A router switches on what the message is and decides where it
			// goes, which is the shape a switch is for. Everything not named
			// below is dropped: a keyboard's clock and its aftertouch have no
			// business in the synth.
			switch (m.kind) {
			case MIDI_PITCH_BEND:
				output.send(m.status, m.data1, m.data2); // wheels pass through untouched
				break;
			case MIDI_NOTE_ON:
				// Velocity 0 is a release under running status, not a press.
				if (m.data2 == 0)
					output.send_note_off(m.channel, pitched(m.data1), 0);
				else
					output.send_note_on(m.channel, pitched(m.data1), m.data2);
				break;
			case MIDI_NOTE_OFF:
				output.send_note_off(m.channel, pitched(m.data1), m.data2);
				break;
			case MIDI_CONTROL_CHANGE:
				output.send(m.status, m.data1, m.data2); // sustain and the rest go through
				break;
			}
		}
		wait(5);
	}

	output.all_notes_off(); // never leave a note sounding
	output.close();
	input.close();
}
