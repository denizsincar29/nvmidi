// nvgt loads this plugin only when the script asks for it by name: without
// the pragma below the engine never opens the library and every midi_* name
#pragma plugin nvmidi
#include "nvmidi_ui.nvgt"
#include "nvmidi_ui_keys.nvgt"

// One byte, back as a one-character string. This engine's string(byte) gives
// the decimal digits of the number rather than the character they stand for -
// measured on a windows runner, where the backend name came out of the byte
// pair as "110118109105100105..." and every comparison against "Windows"
// failed.
//
// A table walked with substr() does not work either, and that is measured too:
// index 32 answers 'W', index 65 answers '-', index 47 answers 'l', and
// substr(67, 1) is already empty on a literal whose length() is 68. The offsets
// are not one constant, so what the engine is doing there is unmeasured; what
// is measured is that the first ten and first twenty six characters of a
// literal read correctly (find("1") is 1, find("A") is 10). That is all this
// branch needs: digits, A-Z and a-z come from those two ranges, the punctuation
// a backend name is made of is a plain branch, and nothing walks the table.
//
// Every bound is a number because a character literal here is a one character
// string, not a code: measured, `b >= '0'` is "No conversion from 'const
// string' to math type available".
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
string char_of(uint b) {
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	return ".";
}


// octave-doubler.nvgt - play a keyboard plugged into the computer through a
// synth running on the same computer.
//
// Reads note messages from one port and forwards them to another, transposed
// and with the velocity scaled. Shows both directions working at once.
// (Renamed from keyboard_to_synth.nvgt: the name should say what it does.)
//
// Press escape to stop. On the way out every note is released, so nothing is
// left sounding. Both ports come from midi_config.txt next to this script.

// Declared here rather than at file scope: a script global is initialised
// before the plugin has registered its types, so a handle kept outside a
// function cannot be assigned to once main() runs.
midi_input@ input;
midi_output@ output;

void panic() {
	output.all_notes_off();
	input.close();
	output.close();
	ui_speak("Stopped.");
}

// The plugin hands its strings over as a count plus an indexed byte - see the
// readme. These put them back together here, where the engine's own strings
// were measured alive.
string bytes_of_config(midi_config@ c) {
	string s = "";
	for (int i = 0; i < c.describe_byte_count(); i++) {
		int b = c.describe_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) {
		int b = midi_last_error_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_port_name(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_input_port_name(midi_input@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}

void main() {
	if (!show_window("nvmidi - keyboard to synth")) {
		ui_speak("Could not open a window.");
		return;
	}
	wait(50); // let the reader speak the window title first

	if (midi_input_port_count() == 0 || midi_output_port_count() == 0) {
		ui_speak("Need at least one input and one output port.");
		return;
	}

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.txt");

	@input = midi_input_create();
	@output = midi_output_create();

	if (!input.open_config(config, "nvmidi forward in")) {
		ui_speak("Input (" + bytes_of_config(config) + "): " + bytes_of_last_error());
		return;
	}
	if (!output.open_config(config, "nvmidi forward out")) {
		ui_speak("Output (" + bytes_of_config(config) + "): " + bytes_of_last_error());
		input.close();
		return;
	}
	ui_speak("From " + bytes_of_input_port_name(input) + " to " + bytes_of_port_name(output) + ", an octave up. Alt+F4 stops.");

	// ui_pump() keeps the window alive and is also the Alt+F4 test, so this
	// loop can always be stopped from the keyboard.
	while (ui_pump()) {
		if (stop_key()) break;
		// As in echo_monitor: one common variable filled by reference, copied
		// into it through midi_message's opAssign behaviour.
		midi_message m;
		while (input.next_message(m)) {
			uint command = m.status & 0xf0;

			if (command == 0x90 && m.data2 > 0) {
				// Note on. Transpose up an octave, but keep it in range.
				int note = m.data1 + 12;
				if (note > 127) note -= 12;
				output.send_note_on(m.channel, note, m.data2);
			} else if (command == 0x80 || (command == 0x90 && m.data2 == 0)) {
				// Note off, including the note-on-with-velocity-zero form
				// many keyboards use.
				int note = m.data1 + 12;
				if (note > 127) note -= 12;
				output.send_note_off(m.channel, note, m.data2);
			} else if (command == 0xe0) {
				// Pitch bend passes through unchanged.
				output.send(m.status, m.data1, m.data2);
			}
			// Everything else is dropped. Add cases here as you need them.
		}
	}

	panic();
}
