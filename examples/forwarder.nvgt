// forwarder.nvgt - keyboard in, synth out, every note an octave higher.
// Escape stops. No switch here: one question per branch, which reads as
// plainly as a switch and keeps it one line per case.

#include "../midi.nvgt"

midi_input@ input;
midi_output@ output;
midi_message m;

int octave_up(int note) {
	int up = note + 12;
	if (up > 127) up -= 12; // wrap rather than go silent at the top
	return up;
}

void main() {
	show_window("nvmidi - keyboard to synth");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@input = midi_input_create();
	@output = midi_output_create();
	if (!input.open_config(config, "nvmidi forward in")) {
		print("Cannot open the input: " + midi_last_error_text() + "\n");
		return;
	}
	if (!output.open_config(config, "nvmidi forward out")) {
		print("Cannot open the output: " + midi_last_error_text() + "\n");
		input.close();
		return;
	}

	while (!key_pressed(KEY_ESCAPE)) {
		while (input.next_message(m)) {
			// A note, either spelling of it, and the two spellings go out as
			// themselves. The plugin's send_note_on already turns a note-on
			// at velocity 0 into a note off, so asking is_note_off here is
			// only to keep the pitch shift on one path.
			if (m.is_note_off) {
				output.send_note_off(m.channel, octave_up(m.data1), m.data2);
			} else if (m.is_note_on) {
				output.send_note_on(m.channel, octave_up(m.data1), m.data2);
			} else if (m.is_control_change) {
				output.send_control_change(m.channel, m.controller, m.data2);
			} else if (m.kind == MIDI_PITCH_BEND) {
				output.send_pitch_bend(m.channel, m.pitch_bend); // shifted notes need it in tune
			}
			// Anything else is deliberately not forwarded.
		}
		wait(5);
	}

	output.all_notes_off(); // never leave a note sounding
	output.close();
	input.close();
}
