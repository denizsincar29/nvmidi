// nvgt loads this plugin only when the script asks for it by name: without
// the pragma below the engine never opens the library and every midi_* name
#pragma plugin nvmidi

// One byte, back as a one-character string. This engine's string(byte) gives
// the decimal digits of the number rather than the character they stand for -
// measured on a windows runner, where the backend name came out of the byte
// pair as "110118109105100105..." and every comparison against "Windows"
// failed. A 64-letter table indexed by the byte is the conversion that works;
// string() is the one that reads well in a byte list and is wrong in a string.
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
string char_of(uint b) {
	if (b < byte_letters.length()) return byte_letters.substr(b, 1);
	return "?";
}


// --- headless safety net -------------------------------------------------
// Measured on the engine: when a script calls screen_reader_speak on a machine
// with no screen reader attached, nvgt does not return from the call - the
// process dies with SIGABRT and nothing that follows runs. That makes every
// script in this repository untestable on a build machine, and it is a
// property of the caller's machine, not of the script.
//
// So the reader is not called at all: the scripts go straight to the engine's
// own dialog box, which speaks through whatever assistive technology is
// running and is readable by a person either way. The caller's machine decides
// how the text arrives, not the script - and on a build machine the script
// runs to the end instead of dying on its first announcement.
void announce(const string&in text) {
	// alert wants a title as its second argument; a bare call does not
	// compile against this engine (measured: "No matching signatures to
	// 'alert(string)'").
	alert(text, "nvmidi");
}

// list_ports.nvgt - print every MIDI port on this machine.
//
// Run this first when something is not working: it tells you which port
// number your keyboard actually landed on, which backend RtMidi picked, and
// which port midi_config.txt selects.

// The plugin hands its strings over as a count plus an indexed byte - see the
// readme. These put them back together here, where the engine's own strings
// were measured alive.
string bytes_of_config(midi_config@ c) {
	string s = "";
	for (int i = 0; i < c.describe_byte_count(); i++) {
		int b = c.describe_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) {
		int b = midi_last_error_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_port_name(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_input_port_name(midi_input@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_output_port_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_output_port_name_byte_count(port); i++) {
		int b = midi_output_port_name_byte(port, i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_input_port_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_input_port_name_byte_count(port); i++) {
		int b = midi_input_port_name_byte(port, i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_api_name() {
	string s = "";
	for (int i = 0; i < midi_api_name_byte_count(); i++) {
		int b = midi_api_name_byte(i);
		s += char_of(b);
	}
	return s;
}
