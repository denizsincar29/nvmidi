// One include gets everything: the plugin itself, the note and controller
// constants, the pitch table, and the string helpers. midi.nvgt carries the
// #pragma plugin line, so nothing else here needs to ask for the library.
#include "midi.nvgt"

// The window helpers are separate on purpose: they are about a window on the
// screen, not about MIDI, and a script that only sends notes does not want them.
#include "nvmidi_ui.nvgt"
#include "nvmidi_ui_keys.nvgt"


// list_ports.nvgt - pick a MIDI port with the arrow keys.
//
// Run this first when something is not working, and when you want the other
// examples to open the right device. Up and down move through the ports, each
// one is spoken as it is highlighted, and enter writes the one you stopped on
// into midi_config.txt. Escape leaves without writing anything. Nothing is
// sent and no port is opened: this script only chooses.
//
// The port list is the inputs, because that is what midi_config feeds:
// open_config() uses find_input_port(). A script that plays takes the same
// number from find_output_port(), and on most keyboards the input and output
// lists line up. The picked index is written as an explicit `port = N`, and
// the `match` line is written empty on purpose - an empty substring cannot
// match anything, so the index is what decides and the same device is chosen
// on the next run. [Change that here if you want a name search instead.]
//
// The file is written into the engine's working directory, which is where
// load() looks for it. That is what makes a picked port stick.

// The plugin hands its strings over as a count plus an indexed byte; the
// wrapper turns each pair into a string. See nvmidi_string.nvgt for why the
// crossing is a byte at a time and not a std::string.
// Says where the selection is now. One port per line, because this engine's
// screen reader speaks each call as it comes (speak_wait in the engine's own
// sound class does the same) - a single sentence holding the whole list would
// bury the port just moved to.
void announce_port(int unused, int chosen, uint count) {
	ui_speak("Port " + (chosen + 1) + " of " + count + ": " + midi_input_port_name_text(chosen));
}

// Writes the choice where the other examples will read it.
//
// This is the file class from the engine's stream library - the manual's page
// for it is doc/src/references/builtin/!Streams/file, and its Methods/open
// page gives the exact signature: bool file::open(string filename, string
// mode), modes a/w/r/r+, and a file opened for writing is created if it is
// not there. The mode used to be "w" alone; the manual's own example passes
// "wb", and the b is accepted and ignored for compatibility, so "w" is left
// as it is. write() is the stream method and returns the byte count, and one
// newline ends each line because there is no write_line() on this class.
//
// The first version of this function called open() and write_line() as free
// functions holding a file handle. That is not the engine's API at all: both
// names failed to compile ("No matching symbol 'open'"), and this is the
// version that the manual supports.
bool write_config(const string&in path, int port) {
	file f;
	if (!f.open(path, "w")) return false;
	f.write("# Chosen with list_ports.nvgt. An empty match cannot match any\n");
	f.write("# port name, so \"port\" is what decides which device is opened.\n");
	f.write("match = \n");
	f.write("port = " + port + "\n");
	f.close();
	return true;
}

void main() {
	if (!ui_open("nvmidi - ports")) {
		return;
	}
	wait(50); // let the reader speak the window title before the list

	// The engine has no argument list to give a script (get_argc and
	// application are refused), so the port also has to survive as a file.
	// "midi_config.txt" is relative, and the engine resolves it against its
	// own working directory rather than this script's folder. That is where
	// load() looks, so it is where this writes.
	const string config_path = "midi_config.txt";

	ui_speak("MIDI backend: " + midi_api_name_text());

	uint inputs = midi_input_port_count();
	if (inputs == 0) {
		ui_speak("No MIDI input ports found. Nothing to choose from. Press Alt+F4 to close.");
		while (ui_pump()) { if (stop_key()) return; }
		return;
	}
	ui_speak(inputs + " input port(s). Up and down choose one, enter writes it to the config, escape leaves without writing.");

	// Which port is already in the config, so the first arrow moves from
	// there instead of from the top of the list.
	midi_config@ current = midi_config_create();
	current.load_if_present(config_path);
	int chosen = current.find_input_port();
	if (chosen < 0 || chosen >= int(inputs)) chosen = 0;

	announce_port(0, chosen, inputs);

	// The loop asks about keys, and it asks two different questions.
	//
	// Escape and Alt+F4 are the stop key, tested exactly the way
	// nvmidi_ui_keys.nvgt tests it everywhere else. Up and down move the
	// selection. Both are listed as just a key read: key_pressed() is level
	// triggered - it answers true for as long as the key is held - so holding
	// an arrow would otherwise run the list away, and key_repeating() is the
	// engine's own name for a key that is held down. Listing both is what the
	// engine's own bundled form and menu scripts do.
	//
	// Enter is different on purpose. "Write it" is a step in a dialog, not a
	// state: the whole run either wrote the file or did not, and writing it a
	// second time before the second is over changes nothing. So enter is a
	// plain read with no edge logic in front of it, and the settle timer is
	// what keeps it to one write - the file is only touched while `entered`
	// is still zero.
	//
	// 30 ms is not a guess either: the engine's own form and menu code call
	// wait(5) per turn, and measured on the engine, key_pressed(KEY_SPACE)
	// stops answering once the turn is longer than 40 ms. 30 is the longest
	// wait that still sees a tap on every one of them.
	const double settle = 1000.0; // how long the last word is left to be spoken
	const double frame = 30.0;
	double entered = 0.0;
	while (true) {
		if (!ui_pump()) return; // escape or Alt+F4: leave without writing
		if (stop_key()) return;

		const bool up = a_key(KEY_UP);
		const bool down = a_key(KEY_DOWN);
		// Enter can come from either key; a keyboard without a numpad has
		// only the main one.
		const bool enter = a_key(KEY_RETURN) || a_key(KEY_NUMPAD_ENTER);

		if (up) {
			chosen = (chosen - 1 + int(inputs)) % int(inputs); // wrap at the ends
			announce_port(0, chosen, inputs);
		}
		if (down) {
			chosen = (chosen + 1) % int(inputs);
			announce_port(0, chosen, inputs);
		}

		// The file is only touched here, and only once, so nothing a held key
		// does can write it twice.
		if (enter && entered == 0.0) {
			// Ask the write, do not assume it. write_config returns false when
			// the file cannot be opened - a read-only folder, or a name an
			// engine has locked - and the line after this used to say "Written"
			// whatever happened, which is a window that lies about the one
			// thing it did.
			if (write_config(config_path, chosen)) {
				ui_speak("Written to the config: input port " + chosen + ", " + midi_input_port_name_text(chosen) + ". Closing in a second.");
			} else {
				ui_speak("Could not write the config. Nothing was changed. Closing in a second.");
			}
			entered = ticks();
		}
		if (entered != 0.0 && ticks() - entered >= settle) return;

		wait(frame);
	}
}
