// list_ports.nvgt - print every MIDI port on this machine.
//
// Run this first when something is not working: it tells you which port
// number your keyboard actually landed on, and which backend RtMidi picked.

void main() {
	screen_reader_speak("MIDI backend: " + midi_api_name());

	uint inputs = midi_input_port_count();
	if (inputs == 0) {
		screen_reader_speak("No MIDI input ports found.");
	} else {
		screen_reader_speak(inputs + " input ports.");
		for (uint i = 0; i < inputs; i++) {
			screen_reader_speak("Input " + i + ": " + midi_input_port_name(i));
		}
	}

	uint outputs = midi_output_port_count();
	if (outputs == 0) {
		screen_reader_speak("No MIDI output ports found.");
	} else {
		screen_reader_speak(outputs + " output ports.");
		for (uint i = 0; i < outputs; i++) {
			screen_reader_speak("Output " + i + ": " + midi_output_port_name(i));
		}
	}

	wait(500);
}
