// list_ports.nvgt - pick the input and the output port and write them to
// midi_config.json, which the other examples read.
// Up and down move, enter takes it, escape leaves without writing.

#include "../midi.nvgt"

midi_input@ probe; // never opened; its name is all this needs

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

bool write_config(const string&in path, int in_port, int out_port) {
	// "match" is written empty on purpose: the plugin tries the name first and
	// falls back to the numbers, and an empty name matches nothing, so a stale
	// name can never override a fresh pick.
	file f;
	if (!f.open(path, "w")) return false;
	f.write("{\n");
	f.write("\t\"match\": \"\",\n");
	f.write("\t\"in_port\": " + in_port + ",\n");
	f.write("\t\"out_port\": " + out_port + "\n");
	f.write("}\n");
	f.close();
	return true;
}

int pick_port(const string&in title, const string[]&in names, int start) {
	const int count = int(names.length());
	if (count == 0) return -1;
	if (start < 0 || start >= count) start = 0;
	int cursor = start;
	say(title + " Currently " + names[cursor] + ".");
	while (true) {
		if (key_pressed(KEY_ESCAPE)) return -1;
		if (key_pressed(KEY_UP) || key_repeating(KEY_UP)) {
			cursor = (cursor == 0) ? count - 1 : cursor - 1;
			say(names[cursor]);
			wait(40);
		} else if (key_pressed(KEY_DOWN) || key_repeating(KEY_DOWN)) {
			cursor = (cursor == count - 1) ? 0 : cursor + 1;
			say(names[cursor]);
			wait(40);
		} else if (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER)) {
			return cursor;
		}
		wait(5);
	}
	return -1; // not reached; keeps the analyser happy about return types
}

void main() {
	show_window("nvmidi - ports");
	say("MIDI backend: " + midi_api_name_text());

	const uint inputs = midi_input_port_count();
	const uint outputs = midi_output_port_count();
	if (inputs == 0 || outputs == 0) {
		say("Found " + inputs + " input(s) and " + outputs + " output(s). Nothing to choose from.");
		return;
	}

	midi_config@ current = midi_config_create();
	current.load_if_present("midi_config.json");
	int in_index = current.find_input_port();
	int out_index = current.find_output_port();
	if (in_index < 0 || in_index >= int(inputs)) in_index = 0;
	if (out_index < 0 || out_index >= int(outputs)) out_index = 0;

	string[] in_names;
	for (uint i = 0; i < inputs; i++) in_names.insert_last(midi_input_port_name_text(i));
	string[] out_names;
	for (uint i = 0; i < outputs; i++) out_names.insert_last(midi_output_port_name_text(i));

	const int picked_in = pick_port("Input port, what you play on.", in_names, in_index);
	if (picked_in < 0) return;
	const int picked_out = pick_port("Output port, what receives the notes.", out_names, out_index);
	if (picked_out < 0) return;

	if (write_config("midi_config.json", picked_in, picked_out)) {
		say("Config written: input " + picked_in + ", " + in_names[picked_in]
			+ "; output " + picked_out + ", " + out_names[picked_out] + ".");
	} else {
		say("Could not write midi_config.json. Nothing was changed.");
	}
}
