// list_ports.nvgt - choose your MIDI input and output and save the choice to
// midi_config.json. The other examples read that file, so run this one first.
// Up and down arrows choose, enter confirms, escape quits without saving.

#include "../midi.nvgt"

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

// Writes the two port numbers to the config file. "match" stays empty so the
// numbers are used rather than a port name from an earlier run.
bool save_config(const string&in path, int input_port, int output_port) {
	file f;
	if (!f.open(path, "w")) return false;
	f.write("{\n");
	f.write("\t\"match\": \"\",\n");
	f.write("\t\"in_port\": " + input_port + ",\n");
	f.write("\t\"out_port\": " + output_port + "\n");
	f.write("}\n");
	f.close();
	return true;
}

// Lets the user walk through `names` with the arrow keys.
// Returns the chosen index, or -1 if they pressed escape.
int choose(const string&in title, const string[]&in names, int start) {
	int count = int(names.length());
	int cursor = start;
	say(title + " " + names[cursor] + ".");
	while (!key_pressed(KEY_ESCAPE)) {
		if (key_pressed(KEY_UP) || key_repeating(KEY_UP)) {
			cursor = (cursor == 0) ? count - 1 : cursor - 1;
			say(names[cursor]);
			wait(40);
		} else if (key_pressed(KEY_DOWN) || key_repeating(KEY_DOWN)) {
			cursor = (cursor == count - 1) ? 0 : cursor + 1;
			say(names[cursor]);
			wait(40);
		} else if (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER)) {
			return cursor;
		}
		wait(5);
	}
	return -1;
}

void main() {
	show_window("nvmidi - choose ports");

	uint inputs = midi_input_port_count();
	uint outputs = midi_output_port_count();
	if (inputs == 0 || outputs == 0) {
		say("Found " + inputs + " inputs and " + outputs + " outputs. Plug in your device and try again.");
		return;
	}

	string[] input_names;
	for (uint i = 0; i < inputs; i++) input_names.insert_last(midi_input_port_name_text(i));
	string[] output_names;
	for (uint i = 0; i < outputs; i++) output_names.insert_last(midi_output_port_name_text(i));

	// Start on the ports chosen last time, if the file exists.
	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	int input_start = config.find_input_port();
	int output_start = config.find_output_port();
	if (input_start < 0 || input_start >= int(inputs)) input_start = 0;
	if (output_start < 0 || output_start >= int(outputs)) output_start = 0;

	int input_port = choose("Input, where you play.", input_names, input_start);
	if (input_port < 0) return;
	int output_port = choose("Output, what makes the sound.", output_names, output_start);
	if (output_port < 0) return;

	if (save_config("midi_config.json", input_port, output_port)) {
		say("Saved. Input: " + input_names[input_port] + ". Output: " + output_names[output_port] + ".");
	} else {
		say("Could not write midi_config.json.");
	}
	wait(1000);
}
