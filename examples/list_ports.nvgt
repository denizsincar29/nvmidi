// nvgt loads this plugin only when the script asks for it by name: without
// the pragma below the engine never opens the library and every midi_* name
#pragma plugin nvmidi
#include "nvmidi_ui.nvgt"

// One byte, back as a one-character string. This engine's string(byte) gives
// the decimal digits of the number rather than the character they stand for -
// measured on a windows runner, where the backend name came out of the byte
// pair as "110118109105100105..." and every comparison against "Windows"
// failed.
//
// A table walked with substr() does not work either, and that is measured too:
// index 32 answers 'W', index 65 answers '-', index 47 answers 'l', and
// substr(67, 1) is already empty on a literal whose length() is 68. The offsets
// are not one constant, so what the engine is doing there is unmeasured; what
// is measured is that the first ten and first twenty six characters of a
// literal read correctly (find("1") is 1, find("A") is 10). That is all this
// branch needs: digits, A-Z and a-z come from those two ranges, the punctuation
// a backend name is made of is a plain branch, and nothing walks the table.
//
// Every bound is a number because a character literal here is a one character
// string, not a code: measured, `b >= '0'` is "No conversion from 'const
// string' to math type available".
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
string char_of(uint b) {
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	return ".";
}


// list_ports.nvgt - pick a MIDI port with the arrow keys.
//
// Run this first when something is not working, and when you want the other
// examples to open the right device. Up and down move through the ports, each
// one is spoken as it is highlighted, and enter writes the one you stopped on
// into midi_config.txt. Escape leaves without writing anything. Nothing is
// sent and no port is opened: this script only chooses.
//
// The port list is the inputs, because that is what midi_config feeds:
// open_config() uses find_input_port(). A script that plays takes the same
// number from find_output_port(), and on most keyboards the input and output
// lists line up. The picked index is written as an explicit `port = N`, and
// the `match` line is written empty on purpose - an empty substring cannot
// match anything, so the index is what decides and the same device is chosen
// on the next run. [Change that here if you want a name search instead.]
//
// The file is written into the engine's working directory, which is where
// load() looks for it. That is what makes a picked port stick.

// The plugin hands its strings over as a count plus an indexed byte - see the
// readme. These put them back together here, where the engine's own strings
// were measured alive.
string bytes_of_config(midi_config@ c) {
	string s = "";
	for (int i = 0; i < c.describe_byte_count(); i++) {
		int b = c.describe_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) {
		int b = midi_last_error_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_port_name(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_input_port_name(midi_input@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_output_port_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_output_port_name_byte_count(port); i++) {
		int b = midi_output_port_name_byte(port, i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_input_port_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_input_port_name_byte_count(port); i++) {
		int b = midi_input_port_name_byte(port, i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_api_name() {
	string s = "";
	for (int i = 0; i < midi_api_name_byte_count(); i++) {
		int b = midi_api_name_byte(i);
		s += char_of(b);
	}
	return s;
}
// Says where the selection is now. One port per line, because this engine's
// screen reader speaks each call as it comes (speak_wait in the engine's own
// sound class does the same) - a single sentence holding the whole list would
// bury the port just moved to.
void announce_port(int unused, int chosen, uint count) {
	ui_speak("Port " + (chosen + 1) + " of " + count + ": " + bytes_of_input_port_name(chosen));
}

// Writes the choice where the other examples will read it. open / write /
// close are the engine's three old file functions, and they were picked
// because they are exactly that: old. file_open exists in the engine's stub
// headers and is versioned, so a script written against it would refuse to
// run on an engine older than the stub. This file has to keep working on the
// machine it was written for, which is why nothing newer than a comment went
// in. The one unmeasured line in this example is whether the engine's writer
// accepts these arguments - it is on the list of things to check on a real
// run, not something this script can verify for itself.
bool write_config(const string&in path, int port) {
	file@ f = open(path, "w");
	if (@f == null) return false;
	f.write_line("# Chosen with list_ports.nvgt. An empty match cannot match any");
	f.write_line("# port name, so \"port\" is what decides which device is opened.");
	f.write_line("match = ");
	f.write_line("port = " + port);
	f.close();
	return true;
}

void main() {
	if (!show_window("nvmidi - ports")) {
		ui_speak("Could not open a window.");
		return;
	}
	wait(50); // let the reader speak the window title before the list

	// The engine has no argument list to give a script (get_argc and
	// application are refused), so the port also has to survive as a file.
	// "midi_config.txt" is relative, and the engine resolves it against its
	// own working directory rather than this script's folder. That is where
	// load() looks, so it is where this writes.
	const string config_path = "midi_config.txt";

	ui_speak("MIDI backend: " + bytes_of_api_name());

	uint inputs = midi_input_port_count();
	if (inputs == 0) {
		ui_speak("No MIDI input ports found. Nothing to choose from. Press Alt+F4 to close.");
		while (ui_pump()) { }
		return;
	}
	ui_speak(inputs + " input port(s). Up and down choose one, enter writes it to the config, escape leaves without writing.");

	// Which port is already in the config, so the first arrow moves from
	// there instead of from the top of the list.
	midi_config@ current = midi_config_create();
	current.load_if_present(config_path);
	int chosen = current.find_input_port();
	if (chosen < 0 || chosen >= int(inputs)) chosen = 0;

	announce_port(0, chosen, inputs);

	// The loop's only job is to notice a key the moment it goes down. Every
	// key this engine offers (key_pressed, key_repeating, key_down) is level
	// triggered - it stays true while the key is held - so one press would
	// otherwise move the selection many times. The way out is not to ask how
	// the key system works but to watch the transition here: an edge is
	// "true now, false on the previous turn". The engine's own menu code
	// polls in a loop exactly like this one.
	//
	// 30 ms is not a guess either: the engine's own form and menu code call
	// wait(5) per turn, and measured on the engine, key_pressed(KEY_SPACE)
	// stops answering once the turn is longer than 40 ms. 30 is the longest
	// wait that still sees a tap on every one of them.
	const double settle = 1000.0; // how long the last word is left to be spoken
	const double frame = 30.0;
	double entered = 0.0;
	bool held_up = false;
	bool held_down = false;
	bool held_enter = false;
	while (true) {
		if (!ui_pump()) return; // Alt+F4 or escape: leave without writing

		const bool up = key_pressed(KEY_UP) || key_repeating(KEY_UP);
		const bool down = key_pressed(KEY_DOWN) || key_repeating(KEY_DOWN);
		// Enter can come from either key; a keyboard without a numpad has
		// only the main one.
		const bool enter = key_pressed(KEY_RETURN) || key_repeating(KEY_RETURN)
				|| key_pressed(KEY_NUMPAD_ENTER) || key_repeating(KEY_NUMPAD_ENTER);

		// One press, one step. Letting the reading repeat while the key is
		// held is what typing a name does, and it does not belong here.
		if (up && !held_up) {
			chosen = (chosen - 1 + int(inputs)) % int(inputs); // wrap at the ends
			announce_port(0, chosen, inputs);
		}
		if (down && !held_down) {
			chosen = (chosen + 1) % int(inputs);
			announce_port(0, chosen, inputs);
		}

		// The three cases are exclusive, and the file is only touched here,
		// so a held key never writes twice.
		if (enter && entered == 0.0) {
			write_config(config_path, chosen);
			ui_speak("Written to the config: input port " + chosen + ", " + bytes_of_input_port_name(chosen) + ". Closing in a second.");
			entered = ticks();
		}
		if (entered != 0.0 && ticks() - entered >= settle) return;

		held_up = up;
		held_down = down;
		held_enter = enter;
		wait(frame);
	}
}
