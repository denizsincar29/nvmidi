// queue_limits.nvgt - shows what happens when a script reads MIDI too slowly.
// Messages wait in a queue that holds 1024. When it is full, the oldest are lost.
// This script reads only one message per second, so play fast and watch it fill.
//   Space  says how full the queue is.
//   C      throws the waiting messages away.
//   Escape quits.

#include "../midi.nvgt"

midi_input@ keyboard;

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

void say_queue_state() {
	uint waiting = keyboard.get_pending();
	string line = waiting + " of 1024 waiting, " + (waiting * 100 / 1024) + " percent full";
	if (keyboard.dropped_messages) line += ", " + keyboard.dropped_count + " lost";
	say(line);
}

void main() {
	show_window("nvmidi - queue limits");

	if (midi_input_port_count() == 0) {
		say("No MIDI input found. Plug in your keyboard first.");
		return;
	}

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@keyboard = midi_input_create();
	if (!keyboard.open_config(config, "queue limits")) {
		say("Cannot open the input: " + midi_last_error_text());
		return;
	}
	say("Listening. Play fast, then press space to hear the queue. Escape quits.");

	midi_message message;
	uint next_read = ticks();
	while (!key_pressed(KEY_ESCAPE)) {
		if (key_pressed(KEY_SPACE)) say_queue_state();
		if (key_pressed(KEY_C)) {
			keyboard.clear();
			say("Cleared.");
		}

		// Read one message per second, on purpose.
		if (ticks() >= next_read) {
			next_read = ticks() + 1000;
			try {
				keyboard.next_message(message);
			} catch {
				// Messages were lost since the last read. Say so, then carry on.
				say("Messages were lost: " + keyboard.dropped_count);
				keyboard.reset_dropped_messages();
			}
		}
		wait(5);
	}
	keyboard.close();
}
