// queue_limits.nvgt - the queue holds 1024 messages, then drops the oldest.
// This reads one a second on purpose, so fast playing fills it and you hear
// the count climb. Nothing is spoken per message - the fill is the whole
// point. Space says where the queue stands; escape stops.

#include "../midi.nvgt"

midi_input@ keyboard;
midi_message m;

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

// Say how full the queue is, in messages and in percent.
void speak_state() {
	uint pending = keyboard.get_pending();
	uint percent = pending * 100 / 1024;
	string line = pending + " of 1024 in the queue, " + percent + " percent full";
	if (keyboard.dropped_messages)
		line += ", " + keyboard.dropped_count + " dropped";
	say(line);
}

void main() {
	show_window("nvmidi - queue limits");

	if (midi_input_port_count() == 0) {
		say("No MIDI input ports. Plug the keyboard in first.");
		return;
	}

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@keyboard = midi_input_create();
	if (!keyboard.open_config(config, "nvmidi queue limits")) {
		say("Cannot open " + midi_config_text(config) + ": " + midi_last_error_text());
		return;
	}
	say("Listening on " + midi_input_name_text(keyboard) + ". Play fast, press space to hear the queue, escape stops.");

	while (!key_pressed(KEY_ESCAPE)) {
		if (key_pressed(KEY_SPACE)) {
			speak_state();
			wait(200); // so one press does not repeat
		}
		if (key_pressed(KEY_C)) { // throw away the backlog instead of reading it
			keyboard.clear();
			say("cleared.");
			wait(200);
		}

		// Deliberately slow: exactly one message per second, so the queue fills.
		// Nothing is said about the message itself - that is the point.
		try {
			keyboard.next_message(m);
		} catch {
			// Thrown by next_message while a drop is unacknowledged.
			say("caught overflow: " + keyboard.dropped_count + " dropped");
			keyboard.reset_dropped_messages();
		}

		// The fallback, and the proof that the two agree: the counter is not
		// cleared by the raise, only by reset_dropped_messages.
		if (keyboard.dropped_messages) {
			say("polled overflow: " + keyboard.dropped_count + " dropped");
			keyboard.reset_dropped_messages();
		}

		wait(1000);
	}
	keyboard.close();
}
