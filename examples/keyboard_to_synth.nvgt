// nvgt loads this plugin only when the script asks for it by name: without
// the pragma below the engine never opens the library and every midi_* name
#pragma plugin nvmidi

// --- headless safety net -------------------------------------------------
// Measured on the engine: when a script calls screen_reader_speak on a machine
// with no screen reader attached, nvgt does not return from the call - the
// process dies with SIGABRT and nothing that follows runs. That makes every
// script in this repository untestable on a build machine, and it is a
// property of the caller's machine, not of the script.
//
// So the scripts try the real reader first, the way they always have, and fall
// back to the engine's own dialog box when there is none. On a user's machine
// the reader is there and nothing changes; on a build machine the script runs
// to the end instead of dying on its first announcement.
void announce(const string&in text) {
	// alert wants a title as its second argument; a bare call does not
	// compile against this engine (measured: "No matching signatures to
	// 'alert(string)'").
	alert(text, "nvmidi");
}


// keyboard_to_synth.nvgt - play a keyboard plugged into the computer through
// a synth running on the same computer.
//
// Reads note messages from one port and forwards them to another, transposed
// and with the velocity scaled. Shows both directions working at once.
//
// Press escape to stop. On the way out every note is released, so nothing is
// left sounding. Both ports come from midi_config.txt next to this script.


// Declared here rather than at file scope: a script global is initialised
// before the plugin has registered its types, so a handle kept outside a
// function cannot be assigned to once main() runs.
midi_input@ input;
midi_output@ output;

void panic() {
	output.all_notes_off();
	input.close();
	output.close();
	announce("Stopped.");
}

void main() {
	if (midi_input_port_count() == 0 || midi_output_port_count() == 0) {
		announce("Need at least one input and one output port.");
		return;
	}

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.txt");

	@input = midi_input_create();
	@output = midi_output_create();

	if (!input.open_config(config, "nvmidi forward in")) {
		announce("Input (" + config.describe() + "): " + midi_last_error());
		return;
	}
	if (!output.open_config(config, "nvmidi forward out")) {
		announce("Output (" + config.describe() + "): " + midi_last_error());
		input.close();
		return;
	}
	announce("From " + input.get_port_name() + " to " + output.get_port_name());

	while (!key_pressed(KEY_ESCAPE)) {
		midi_message m;
		while (input.next_message(m)) {
			uint command = m.status & 0xf0;

			if (command == 0x90 && m.data2 > 0) {
				// Note on. Transpose up an octave, but keep it in range.
				int note = m.data1 + 12;
				if (note > 127) note -= 12;
				output.send_note_on(m.channel, note, m.data2);
			} else if (command == 0x80 || (command == 0x90 && m.data2 == 0)) {
				// Note off, including the note-on-with-velocity-zero form
				// many keyboards use.
				int note = m.data1 + 12;
				if (note > 127) note -= 12;
				output.send_note_off(m.channel, note, m.data2);
			} else if (command == 0xe0) {
				// Pitch bend passes through unchanged.
				output.send(m.status, m.data1, m.data2);
			}
			// Everything else is dropped. Add cases here as you need them.
		}
		wait(5);
	}

	panic();
}
