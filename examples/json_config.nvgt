// json_config.nvgt - read the examples' MIDI port config from JSON,
// without the plugin's midi_config class.
//
// This file exists because the class is C++ and the format is a fact of the
// script, not of the plugin. `midi_config::load_if_present()` only understands
// the `key = value` file the older examples ship; a script that wants JSON
// parses it itself and then calls the plugin's free functions, which is what
// this does. Nothing here needs a rebuild of the plugin, and the class stays
// exactly where it is for the scripts that already use it.
//
// The file, `midi_config.json`, next to this one:
//
//     {
//         "# comment": "keys starting with # are ignored, so JSON can be documented",
//         "match": "nord",
//         "in_port": 2,
//         "out_port": 1,
//         "velocity_scale": 1.0,
//         "channel": 0
//     }
//
// Every key is optional. `match` is a case insensitive piece of a port name;
// `in_port` and `out_port` are the numbers used when no name matched;
// `velocity_scale` multiplies every note's velocity (1.0 is unchanged);
// `channel` is the MIDI channel to send on, but only when the incoming
// message's own channel is -1, i.e. the caller asked this config to choose.
//
// Unlike midi_config, a match that does not find anything is an error here:
// `pick_*` returns -1 rather than silently opening port 0, because a config
// file that is present and names a device the machine does not have is almost
// always a typo, and port 0 is the wrong device. That is the difference the
// JSON path buys, and it is the reason this file is worth having.

#pragma plugin nvmidi
// Constants before the string helpers: nvmidi_string.nvgt reads PITCH_NAMES,
// which is what midi.nvgt does too. json_value.nvgt then carries its own copy
// of the same two includes, so this file compiles standing alone.
#include "../nvmidi_constants.nvgt"
#include "../nvmidi_string.nvgt"
#include "json_value.nvgt"

// ---- the config in memory -------------------------------------------------

class json_config {
	// The file that answered, or "" when none was found. `loaded` says which of
	// the two happened; `path` alone cannot, because a missing file still
	// records the name it looked for.
	string path;
	bool loaded;

	string match;
	int in_port;
	int out_port;
	double velocity_scale;
	int channel;

	json_config() {
		path = "";
		loaded = false;
		match = "";
		in_port = -1;
		out_port = -1;
		velocity_scale = 1.0;
		channel = -1;
	}

	// Read `path`. Returns false and sets error_text when the file is present
	// but not readable or not JSON. A file that is simply not there leaves the
	// defaults above in place and returns true: "no config" is not a fault.
	bool load(const string&in wanted) {
		path = wanted;
		loaded = false;
		if (!file_exists(path)) return true;

		// The engine's own `file` class, not a helper: the include folder has
		// get_file_contents() but it lives in a file this example does not
		// pull in, and three lines here are cheaper than another include.
		file f;
		if (!f.open(path, "rb")) {
			error_text = path + ": cannot be read";
			return false;
		}
		string text = f.size > 0 ? f.read() : "";
		f.close();
		json_value@ root;
		string error;
		if (!json_parse(text, root, error)) {
			error_text = path + ": " + error;
			return false;
		}
		if (@root == null || root.kind != JSON_OBJECT) {
			error_text = path + ": the top level is not an object";
			return false;
		}
		loaded = true;

		// Wrong types are ignored rather than fatal: a config that says
		// "in_port": "two" should not stop a musician, and the default it
		// leaves behind is the same one an absent key would.
		match = root.string_or("match", match);
		in_port = root.int_or("in_port", root.int_or("input_port", in_port));
		out_port = root.int_or("out_port", root.int_or("output_port", out_port));
		velocity_scale = root.number_or("velocity_scale", velocity_scale);
		channel = root.int_or("channel", channel);
		return true;
	}

	// The port this config names for one side, or -1 when it names none that
	// the machine has. The name is tried first, exactly as midi_config::pick
	// does; the number is the fallback.
	int pick(bool input) const {
		if (input && in_port >= 0 && uint(in_port) < midi_input_port_count()) return in_port;
		if (!input && out_port >= 0 && uint(out_port) < midi_output_port_count()) return out_port;
		if (match != "") {
			const int found = input ? midi_find_input_port(match) : midi_find_output_port(match);
			if (found >= 0) return found;
		}
		return -1;
	}

	int pick_input() const { return pick(true); }
	int pick_output() const { return pick(false); }

	// What was decided, in the words the examples speak.
	string describe(bool input) const {
		const int port = pick(input);
		if (port < 0) {
			if (match == "") return "no match and no port number";
			return "nothing in the port list matches \"" + match + "\"";
		}
		if (input) return midi_input_port_name_text(uint(port)) + " (port " + port + ")";
		return midi_output_port_name_text(uint(port)) + " (port " + port + ")";
	}

	// The whole config as one line, for a log or a spoken announcement.
	string to_text() const {
		string s = loaded ? ("config " + path) : "no config file";
		s += ", match \"" + match + "\"";
		s += ", in_port " + in_port + ", out_port " + out_port;
		if (velocity_scale != 1.0) s += ", velocity " + velocity_scale;
		if (channel >= 0) s += ", channel " + channel;
		return s;
	}

	string error_text;
}

// ---- default instance -----------------------------------------------------
//
// A script that wants no config at all still gets a usable object; this is the
// counterpart of midi_config_create().
json_config@ json_config_default() {
	json_config@ c = json_config();
	return c;
}

// ---- run it ---------------------------------------------------------------
//
// The sweep compiles and runs every examples/*.nvgt, and a script is run for
// its body rather than its exit code - so this one has to say what the config
// parses to and stop, without opening a port. It reads the repository's own
// committed examples/midi_config.json, whose keys it only takes back out, so
// it needs no MIDI device and cannot fail on one.
//
// A missing or malformed file is reported and is not a fault: this is a check
// of the reader, and the message is what a user would see.

void main() {
	json_config@ c = json_config();
	if (!c.load("midi_config.json")) {
		print("json_config: no config read: " + c.error_text);
		return;
	}
	print("json_config: " + c.to_text());
	print("json_config: match \"" + c.match + "\", in_port " + c.in_port
		+ ", out_port " + c.out_port + ", velocity_scale " + c.velocity_scale
		+ ", channel " + c.channel);
	// The reader standalone, since this file includes it and the sweep runs
	// the file for its body: the call is here rather than a second main().
	json_value_main();
}
