#pragma plugin nvmidi

// test_config.nvgt - end to end smoke test of midi_config: the match and port
// members, load, load_if_present, find_input_port, find_output_port,
// get_last_port, describe and get_path, and that a missing file is reported
// rather than fatal. One line per check, printed and appended to apitest.log.
//
// Run it from a directory that holds midi_config.txt (match=zzzznope, port=1)
// and midi_config_named.txt (match=nord, port=0). Ports on the test machine:
// inputs 0 MOTU M Series MIDI In 0, 1 Nord Piano 6 MIDI 1; outputs 0 Microsoft
// GS Wavetable Synth 0, 1 MOTU M Series MIDI Out 1, 2 Nord Piano 6 MIDI 2.
//
// Startup cue: main() opens output port 2 once and plays C-E-G twice (the
// second after a short gap) before any check, so the person at the piano hears
// that a run has begun. That port is opened only once and closed at the end.
// If it cannot be opened the cue logs a FAIL and every check still runs.

const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
string char_of(uint b) {
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	// The plugin does emit brackets - a fallback description is
	// "MOTU ... (fallback port 0)" - and without these two lines the
	// reconstruction turns them into dots and every comparison against a
	// bracketed string fails for a reason that is not the plugin.
	if (b == 40) return "(";
	if (b == 41) return ")";
	return ".";
}

int g_pass = 0;
int g_fail = 0;

string bstr(bool b) { if (b) return "true"; return "false"; }

void check(const string&in name, bool ok, const string&in detail) {
	string verdict = ok ? "PASS" : "FAIL";
	string line = "TEST " + name + " " + verdict + " " + detail;
	file_put_contents("apitest.log", line + "\n", true);
	print(line + "\n");
	if (ok) g_pass += 1;
	else g_fail += 1;
}

string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) s += char_of(midi_last_error_byte(i));
	return s;
}
string bytes_of_describe(midi_config@ c) {
	string s = "";
	for (int i = 0; i < c.describe_byte_count(); i++) s += char_of(c.describe_byte(i));
	return s;
}
string bytes_of_path(midi_config@ c) {
	string s = "";
	for (int i = 0; i < c.get_path_byte_count(); i++) s += char_of(c.get_path_byte(i));
	return s;
}

// The startup cue: C-E-G on channel 1, held 800 ms, then the same again after
// a short gap. Uses the object main() already opened; it never opens a port.
void startup_cue(midi_output@ mo) {
	for (int pass = 0; pass < 2; pass++) {
		mo.send_note_on(1, 60, 100);
		mo.send_note_on(1, 64, 100);
		mo.send_note_on(1, 67, 100);
		wait(800);
		mo.send_note_off(1, 60, 0);
		mo.send_note_off(1, 64, 0);
		mo.send_note_off(1, 67, 0);
		mo.all_notes_off();
		if (pass == 0) wait(250);
	}
}

void main() {
	file_put_contents("apitest.log", "", false);

	// -- startup cue: open port 2 and beep C-E-G twice, before any check ---
	midi_output@ cue = midi_output_create();
	bool cue_open = cue.open(uint(2));
	if (!cue_open) {
		check("startup_cue", false, "cannot open output port 2: " + bytes_of_last_error());
	} else {
		startup_cue(cue);
		check("startup_cue", true, "opened output port 2");
	}

	midi_config@ cfg = midi_config_create();
	check("config_default_port_0", cfg.port == 0, "port=" + cfg.port);
	cfg.port = 1;
	check("config_port_settable", cfg.port == 1, "port=" + cfg.port);

	// -- load a real file (fallback path: nothing matches, port=1) ---------
	bool load_fb = cfg.load("midi_config.txt");
	check("config_load_file_returns_true", load_fb, "returned=" + bstr(load_fb) + " error=" + bytes_of_last_error());
	int fb_in = cfg.find_input_port();
	check("config_fallback_find_input_port_1", fb_in == 1, "found=" + fb_in);
	check("config_fallback_get_last_port_1", cfg.get_last_port() == 1, "last_port=" + cfg.get_last_port());
	check("config_fallback_describe_doc", bytes_of_describe(cfg) == "Nord Piano 6 MIDI 1 (fallback port 1)", "text=" + bytes_of_describe(cfg));
	int fb_out = cfg.find_output_port();
	check("config_fallback_find_output_port_1", fb_out == 1, "found=" + fb_out + " text=" + bytes_of_describe(cfg));

	// -- load_if_present: a missing file is not fatal ----------------------
	bool ifp_missing = cfg.load_if_present("no_such_file_zzz.txt");
	check("config_load_if_present_missing_returns_false", !ifp_missing, "returned=" + bstr(ifp_missing));
	check("config_load_if_present_missing_no_error", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	bool ifp_present = cfg.load_if_present("midi_config.txt");
	check("config_load_if_present_present_returns_true", ifp_present, "returned=" + bstr(ifp_present) + " error=" + bytes_of_last_error());

	// -- load: a missing file is an error ----------------------------------
	bool load_missing = cfg.load("no_such_file_zzz.txt");
	check("config_load_missing_returns_false", !load_missing, "returned=" + bstr(load_missing));
	check("config_load_missing_reports_error", midi_last_error_byte_count() > 0, "last_error=" + bytes_of_last_error());

	// -- a config that matches by name -------------------------------------
	midi_config@ cfg2 = midi_config_create();
	bool load_named = cfg2.load("midi_config_named.txt");
	check("config_named_load_returns_true", load_named, "returned=" + bstr(load_named) + " error=" + bytes_of_last_error());
	int named_in = cfg2.find_input_port();
	check("config_named_find_input_port_1", named_in == 1, "found=" + named_in + " text=" + bytes_of_describe(cfg2));
	check("config_named_describe_doc", bytes_of_describe(cfg2) == "Nord Piano 6 MIDI 1", "text=" + bytes_of_describe(cfg2) + " last_port=" + cfg2.get_last_port());
	int named_out = cfg2.find_output_port();
	check("config_named_find_output_port_2", named_out == 2, "found=" + named_out);
	check("config_named_output_describe_doc", bytes_of_describe(cfg2) == "Nord Piano 6 MIDI 2", "text=" + bytes_of_describe(cfg2) + " last_port=" + cfg2.get_last_port());

	// -- get_path ----------------------------------------------------------
	check("config_get_path_bytes", cfg2.get_path_byte_count() == 21 && bytes_of_path(cfg2) == "midi_config_named.txt", "count=" + cfg2.get_path_byte_count() + " path=" + bytes_of_path(cfg2));

	// -- the members set from the script -----------------------------------
	cfg2.match = "motu";
	cfg2.port = 0;
	int motu_in = cfg2.find_input_port();
	check("config_script_match_motu_input_0", motu_in == 0, "found=" + motu_in + " text=" + bytes_of_describe(cfg2));
	int motu_out = cfg2.find_output_port();
	check("config_script_match_motu_output_1", motu_out == 1, "found=" + motu_out + " text=" + bytes_of_describe(cfg2));

	// -- reading the match member back (a string crossing out) -------------
	string match_read = cfg2.match;
	check("config_match_member_read", match_read == "motu", "value=" + match_read);

	cue.all_notes_off();
	cue.close();

	string result = "RESULT pass=" + g_pass + " fail=" + g_fail;
	file_put_contents("apitest.log", result + "\n", true);
	print(result + "\n");
	return;
}
