// octave_up_forwarder.nvgt - everything you play on the keyboard is sent to the
// output port one octave higher. Escape quits.

#include "../midi.nvgt"

// One octave is 12 notes. Notes above the top of the range wrap down.
int octave_up(int note) {
	int up = note + 12;
	if (up > 127) up -= 12;
	return up;
}

void main() {
	show_window("nvmidi - keyboard to synth, an octave up");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	midi_input@ keyboard = midi_input_create();
	midi_output@ synth = midi_output_create();

	if (!keyboard.open_config(config, "forward in")) {
		print("Cannot open the input: " + midi_last_error_text() + "\n");
		return;
	}
	if (!synth.open_config(config, "forward out")) {
		print("Cannot open the output: " + midi_last_error_text() + "\n");
		keyboard.close();
		return;
	}
	screen_reader_speak("Ready. Play something. Escape quits.", false);

	midi_message m;
	while (!key_pressed(KEY_ESCAPE)) {
		while (keyboard.next_message(m)) {
			if (m.is_note_off) {
				synth.send_note_off(m.channel, octave_up(m.data1), m.data2);
			} else if (m.is_note_on) {
				synth.send_note_on(m.channel, octave_up(m.data1), m.data2);
			} else if (m.is_control_change) {
				synth.send_control_change(m.channel, m.controller, m.data2); // pedals and knobs
			} else if (m.kind == MIDI_PITCH_BEND) {
				synth.send_pitch_bend(m.channel, m.pitch_bend);
			}
			// Everything else is ignored.
		}
		wait(5);
	}

	synth.all_notes_off(); // never leave a note stuck
	synth.close();
	keyboard.close();
}
