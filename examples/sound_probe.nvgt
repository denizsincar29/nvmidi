// sound_probe.nvgt - a quick check that sound really works.
// You should hear four notes in a row, and a number is spoken before each one.
// At the end it tells you how long it took: about 3 seconds is right.

#include "../midi.nvgt"

midi_output@ synth;
int g_notes_played = 0;

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

// How many notes were played. Handy when another script checks the result.
int sound_probe_count() {
	return g_notes_played;
}

void play(int pitch, double length_ms) {
	g_notes_played += 1;
	say("" + g_notes_played);
	midi_note@ note = nvmidi_note_create(pitch, 100);
	note.length = midi_duration_create(length_ms, MIDI_MS);
	synth.play_note_wait(note);
}

void main() {
	show_window("nvmidi - sound probe");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@synth = midi_output_create();
	if (!synth.open_config(config, "probe")) {
		say("Cannot open an output port: " + midi_last_error_text());
		return;
	}

	uint64 started = ticks();
	play(60, 700); // C
	play(64, 700); // E
	play(67, 700); // G
	play(72, 900); // C an octave up, a little longer so the end is clear
	uint64 took = ticks() - started;

	synth.close();
	if (took >= 3000) say("Done. It took " + took + " milliseconds, as expected.");
	else say("Something is wrong: it took only " + took + " milliseconds, it should be about 3000.");
	wait(1000);
}
