// music_quickstart.nvgt - plays a chord, an arpeggio and a scale.
// Uses the output port saved by list_ports.nvgt (see midi_config.json).

#include "../midi.nvgt"

// Prints a line and speaks it with your screen reader.
void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

void main() {
	show_window("nvmidi - music quickstart");

	// Open the output port from midi_config.json.
	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	midi_output@ synth = midi_output_create();
	if (!synth.open_config(config, "quickstart")) {
		say("Cannot open an output port: " + midi_last_error_text());
		return;
	}

	synth.tempo = 96.0; // beats per minute

	// A chord: three notes, each one beat long.
	array<midi_note@> triad;
	string[] names = {"C4", "E4", "G4"};
	for (uint i = 0; i < names.length(); i++) {
		midi_note@ note = midi_note_named(names[i], 100); // name, velocity
		note.length = synth.duration(1.0, MIDI_BEATS);
		triad.insert_last(note);
	}

	say("Chord.");
	synth.play_chord_wait(triad); // all together, returns when they stop

	say("Arpeggio.");
	synth.play_midi_chord_wait(triad, "arpeggio"); // one after another, overlapping

	// A scale: eight notes, half a beat each.
	array<midi_note@> scale;
	for (int i = 0; i < 8; i++) {
		midi_note@ note = nvmidi_note_create(60 + i * 2, 90); // pitch number, velocity
		note.length = synth.duration(0.5, MIDI_BEATS);
		scale.insert_last(note);
	}

	say("Scale.");
	synth.play_sequence(scale);

	synth.close();
	say("Done.");
	wait(1000); // let the last word be spoken
}
