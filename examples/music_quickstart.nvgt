#pragma plugin nvmidi

// music_quickstart.nvgt - the high level half of nvmidi, with none of the
// scaffolding the test files carry.
//
// Open this beside test_music.nvgt and the difference is the whole point. The
// tests rebuild plugin strings byte by byte, log every check and count
// pass/fail, because they assert on the interface. This one just plays; read
// this one when you want to know what the music API looks like.
//
//   nvgt.exe music_quickstart.nvgt
//
// The notes come out of the keyboard's own sound engine, so what you hear is
// the instrument, not this program.

void main() {
	// Which port. 2 is the Nord on the machine this was written for; run
	// examples\list_ports.nvgt on yours and change the number.
	midi_output@ mo = midi_output_create();
	if (!mo.open(2)) {
		// A string cannot come back out of the plugin, so say it in words.
		print("Cannot open MIDI output port 2 - run examples\\list_ports.nvgt to see the numbers.\n");
		return;
	}

	// One tempo for everything below. A length is written in the unit you
	// think in and resolved against it.
	mo.tempo = 96.0;

	// A note is pitch and velocity; its length is a duration.
	array<midi_note@>@ triad = array<midi_note@>();
	midi_note@ c = nvmidi_note_create(60, 100);   // middle C
	midi_note@ e = nvmidi_note_create(64, 100);
	midi_note@ g = nvmidi_note_create(67, 100);
	c.length = mo.duration(1.0, MIDI_BEATS);     // one beat at 96 bpm
	e.length = mo.duration(1.0, MIDI_BEATS);
	g.length = mo.duration(1.0, MIDI_BEATS);
	triad.insert_last(c);
	triad.insert_last(e);
	triad.insert_last(g);

	// The same three notes, laid out in time two ways.
	mo.play_midi_chord_wait(triad, "arpeggio");  // C, then E, then G
	mo.play_midi_chord_wait(triad, "chord");     // all three together

	// A scale: each note for its own length, one after another. That is what
	// play_sequence is - see doc/api.md for the other pattern names.
	array<midi_note@>@ scale = array<midi_note@>();
	for (int i = 0; i < 8; i++) {
		midi_note@ n = nvmidi_note_create(60 + i * 2, 90);
		n.length = mo.duration(0.5, MIDI_BEATS);
		scale.insert_last(n);
	}
	mo.play_sequence(scale);

	mo.all_notes_off();   // never leave a note sounding
	mo.close();
	print("music_quickstart: done\n");
}
