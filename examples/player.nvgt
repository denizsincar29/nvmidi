// player.nvgt - two ways to play a single note.
//   1. play_note_wait: you give the note a length, the plugin holds it for you.
//   2. send_note_on / send_note_off: you decide when it starts and when it stops.

#include "../midi.nvgt"

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

void main() {
	show_window("nvmidi - two ways to play a note");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	midi_output@ synth = midi_output_create();
	if (!synth.open_config(config, "player")) {
		say("Cannot open an output port: " + midi_last_error_text());
		return;
	}

	// Way 1: a note that lasts one beat. At 96 beats per minute that is 625 ms.
	synth.tempo = 96.0;
	midi_note@ note = midi_note_named("C4", 100);
	note.length = synth.duration(1.0, MIDI_BEATS);
	say("Way one: the plugin holds the note for one beat.");
	synth.play_note_wait(note);

	// Way 2: the same note, but you start it, wait, and stop it yourself.
	// Arguments: channel (1 to 16), note number (60 is C4), velocity.
	say("Way two: you hold the note for one second.");
	synth.send_note_on(1, 60, 100);
	wait(1000);
	synth.send_note_off(1, 60, 0);

	synth.close();
	say("Done.");
	wait(1000);
}
