// nvgt loads this plugin only when the script asks for it by name: without
// the pragma below the engine never opens the library and every midi_* name
#pragma plugin nvmidi

// --- headless safety net -------------------------------------------------
// Measured on the engine: when a script calls screen_reader_speak on a machine
// with no screen reader attached, nvgt does not return from the call - the
// process dies with SIGABRT and nothing that follows runs. That makes every
// script in this repository untestable on a build machine, and it is a
// property of the caller's machine, not of the script.
//
// So the reader is not called at all: the scripts go straight to the engine's
// own dialog box, which speaks through whatever assistive technology is
// running and is readable by a person either way. The caller's machine decides
// how the text arrives, not the script - and on a build machine the script
// runs to the end instead of dying on its first announcement.
void announce(const string&in text) {
	// alert wants a title as its second argument; a bare call does not
	// compile against this engine (measured: "No matching signatures to
	// 'alert(string)'").
	alert(text, "nvmidi");
}


// play_chord.nvgt - play chords and patterns on the keyboard's own sound.
//
// This is the high level layer on its own: no synthesis, no second device.
// The notes are sent back out of the same keyboard, so its built in engine
// makes them heard. The port comes from midi_config.txt next to this script.


// Builds an array of notes out of a comma separated list, so a test can be
// written as "60,64,67" instead of four lines of object juggling.
array<midi_note@>@ chord(const string&in pitches, double length_ms) {
	array<midi_note@>@ notes = array<midi_note@>();
	string[]@ parts = pitches.split(",");
	for (uint i = 0; i < parts.length(); i++) {
		// Not a ternary: Angelscript cannot choose between two object handles
		// in ?:.
		midi_note@ note;
		int number = midi_note_number(parts[i].trim_whitespace());
		if (number >= 0)
			@note = nvmidi_note_create(number);
		else
			@note = nvmidi_note_create(parse_int(parts[i].trim_whitespace()));
		note.velocity = 100;
		note.length = midi_duration(length_ms, MIDI_MS);
		notes.insert_last(@note);
	}
	return notes;
}


// The plugin hands its strings over as a count plus an indexed byte - see the
// readme. These put them back together here, where the engine's own strings
// were measured alive.
string bytes_of_config(midi_config@ c) {
	string s = "";
	for (int i = 0; i < c.describe_byte_count(); i++) s += string(c.describe_byte(i));
	return s;
}

string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) s += string(midi_last_error_byte(i));
	return s;
}

string bytes_of_port_name(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) s += string(o.get_port_name_byte(i));
	return s;
}

string bytes_of_input_port_name(midi_input@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) s += string(o.get_port_name_byte(i));
	return s;
}

string bytes_of_message(midi_message@ m) {
	string s = "";
	for (int i = 0; i < m.to_string_byte_count(); i++) s += string(m.to_string_byte(i));
	return s;
}
void main() {
	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.txt");

	int port = config.find_input_port();
	if (port < 0) {
		announce("No port matches " + config.match + " and the fallback is empty. Check midi_config.txt.");
		return;
	}

	midi_input@ keyboard = midi_input_create();
	if (!keyboard.open_config(config, "nvmidi chord test")) {
		announce("Cannot open: " + bytes_of_last_error());
		return;
	}
	announce("Playing on " + bytes_of_config(config));

	// The tempo lives on the music class, so a note written as "a beat" means
	// one beat here and not the 120 default. duration() reads that tempo for
	// you: change keyboard.tempo once and every length follows.
	keyboard.tempo = 96.0;

	// A major chord, all notes at once, held for a second.
	keyboard.play_chord_wait(chord("60,64,67", 1000));

	// The same chord in every unit the duration object understands: a beat
	// at the class tempo, half a bar, and a length counted in MIDI ticks.
	// Beats and bars are converted by the duration itself, so a script can
	// think in music and pass milliseconds only where the hardware demands it.
	midi_duration beat = keyboard.duration(1.0, MIDI_BEATS);
	midi_duration half_bar = keyboard.duration(0.5, MIDI_BARS);
	midi_duration ticks = midi_duration(96.0, MIDI_TICKS);

	announce("At " + keyboard.tempo + " bpm a beat is " + beat.to_ms() + " milliseconds, half a bar is " + half_bar.to_ms() + ".");

	array<midi_note@>@ held = chord("60,64,67", 0);
	held[0].length = ticks;
	keyboard.play_chord_wait(held);

	// An explicitly qualified unit wins over the class tempo: MUSIC_BEATS_120
	// is always a beat at 120, whatever keyboard.tempo says. Useful for a
	// short test that should sound the same on every run.
	array<midi_note@>@ steady = chord("60,64,67", 0);
	steady[0].length = keyboard.duration(1.0, MUSIC_BEATS_120);
	keyboard.play_chord_wait(steady);

	// Every pattern the player knows, on one chord, so the difference between
	// them is audible in one run.
	string[]@ patterns = {"chord", "spread", "arpeggio", "quick", "fast", "strum", "repeat"};
	for (uint i = 0; i < patterns.length(); i++) {
		announce(patterns[i]);
		keyboard.play_midi_chord_wait(chord("60,64,67,71", 220), patterns[i]);
	}

	announce("Done.");
	keyboard.close();
	wait(500);
}
