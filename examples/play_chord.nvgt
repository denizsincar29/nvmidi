// play_chord.nvgt - one chord, every pattern the player knows, and a key that
// plays it again. Escape stops.
//
// The length is set through a local handle rather than through notes[i]: the
// engine refuses a field assignment through an indexed handle.

#include "../midi.nvgt"

midi_output@ synth;

void say(const string&in text) {
	print(text + "\n");
	if (SCREEN_READER_AVAILABLE) screen_reader_speak(text, false);
}

array<midi_note@>@ triad(double ms) {
	array<midi_note@>@ notes = array<midi_note@>();
	string[] names = {"C4", "E4", "G4"};
	for (uint i = 0; i < names.length(); i++) {
		midi_note@ n = midi_note_named(names[i], 100);
		n.length = midi_duration_create(ms, MIDI_MS);
		notes.insert_last(n);
	}
	return notes;
}

void main() {
	show_window("nvmidi - chords");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@synth = midi_output_create();
	if (!synth.open_config(config, "nvmidi chords")) {
		say("Cannot open an output port: " + midi_last_error_text());
		return;
	}
	synth.tempo = 96.0;

	say("All three at once.");
	synth.play_chord_wait(triad(700.0));

	string[]@ patterns = {"chord", "spread", "arpeggio", "quick", "fast", "strum", "repeat"};
	for (uint i = 0; i < patterns.length(); i++) {
		say(patterns[i]);
		synth.play_midi_chord_wait(triad(220.0), patterns[i]);
	}

	say("Space plays it again. Escape stops.");
	while (!key_pressed(KEY_ESCAPE)) {
		if (key_pressed(KEY_SPACE)) synth.play_chord_wait(triad(700.0));
		wait(5);
	}
	synth.all_notes_off();
	synth.close();
}
