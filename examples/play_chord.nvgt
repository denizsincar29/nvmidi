// play_chord.nvgt - plays one chord, then the same chord in every pattern.
// Space plays the chord again. Escape quits.

#include "../midi.nvgt"

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

// Builds C major (C, E, G) where every note lasts `ms` milliseconds.
array<midi_note@>@ triad(double ms) {
	array<midi_note@>@ notes = array<midi_note@>();
	string[] names = {"C4", "E4", "G4"};
	for (uint i = 0; i < names.length(); i++) {
		midi_note@ note = midi_note_named(names[i], 100);
		note.length = midi_duration_create(ms, MIDI_MS);
		notes.insert_last(note);
	}
	return notes;
}

void main() {
	show_window("nvmidi - chords");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	midi_output@ synth = midi_output_create();
	if (!synth.open_config(config, "chords")) {
		say("Cannot open an output port: " + midi_last_error_text());
		return;
	}

	say("All three notes at once.");
	synth.play_chord_wait(triad(700));

	// Each pattern spreads the same three notes out in time differently.
	string[] patterns = {"chord", "spread", "arpeggio", "quick", "fast", "strum", "repeat"};
	for (uint i = 0; i < patterns.length(); i++) {
		say(patterns[i]);
		synth.play_midi_chord_wait(triad(220), patterns[i]);
	}

	say("Press space to play it again, escape to quit.");
	while (!key_pressed(KEY_ESCAPE)) {
		if (key_pressed(KEY_SPACE)) synth.play_chord_wait(triad(700));
		wait(5);
	}
	synth.close();
}
