// nvmidi_ui.nvgt - the small helper the windowed examples #include.
//
// It gives them three things and nothing else, because an example should read
// as the API it teaches:
//
//   ui_speak(text)                      speak through the screen reader and
//                                       print the same words
//   ui_pump()                           keep the window alive; false once the
//                                       user pressed Alt+F4 or escape
//   ui_play_background(synth, notes, step_ms, on_frame)
//                                       play a group of notes in the
//                                       background while the caller keeps
//                                       updating other things; false if
//                                       Alt+F4 interrupted it
//
// The pragma below is not redundant with the one in the including script.
// Measured: AngelScript gives every included file its own compilation unit, so
// the included file never sees a plugin the *including* one loaded - the first
// version of this helper had no pragma and all five examples that include it
// failed with "Identifier 'midi_output' is not a data type in global
// namespace" on line 60. A file that names a plugin type has to ask for the
// plugin itself.
#pragma plugin nvmidi
//
// The callback is an AngelScript function handle (funcdef ui_tick below).
// Measured on this engine: a handler can be stored in a global and called
// again, so no base class was needed. Pass null for no per frame work.

funcdef void ui_tick();

// Speak and print the same words. SCREEN_READER_AVAILABLE is checked first:
// measured, with no reader attached screen_reader_speak aborts the process
// instead of returning, so on a build machine the print would never happen.
void ui_speak(const string&in text) {
	print(text + "\n");
	if (SCREEN_READER_AVAILABLE) screen_reader_speak(text, false);
}

// Open the example's window, or say why it could not be opened.
//
// show_window does NOT answer a bool on the engine this repository pins. CI
// says so in as many words: "ERROR: Can't implicitly convert from
// 'game_window@&' to 'bool'." (run 37131438296, examples/nvmidi_ui.nvgt:56).
// The handle is what it returns; a bare `if (!show_window(title))` does not
// compile against it.
//
// The type name `game_window` is equally unusable - it is not in the engine's
// scripting registration, so `game_window@ w = show_window(...)` answers
// "Identifier 'game_window' is not a data type". Neither the bool nor the
// spelled-out handle is portable, which leaves the one form that names no type
// at all: `auto`. It adopts whatever the engine returns and lets the `is null`
// test work on either registration.
//
// Caught twice, and the two failures are why this comment is long. Дениз hit
// the game_window version first, 2026-10-03; then a "fix" that read the
// signature out of a source tree (src/UI.cpp:785 says `bool show_window(...)`)
// was committed as 4f66485 and broke the build the other way. A source tree is
// not the registration list, and this file has now been wrong in both
// directions from assuming which one it was.
//
// The test is written the way the engine writes it for itself: bgt_compat.nvgt
// line 89 is `return show_window(title) !is null;`, test applied to the call's
// result. show_window answers a handle, and `unknown is null` on a value - or
// `auto w = ...; w is null` - is a compile error, "both operands must be
// handles when comparing identity". The call result is a handle; a variable
// holding it is not, which is the whole of the trap. This file guessed the
// signature twice and was wrong twice; the engine's own compat layer is the
// one place the answer was already written down.
bool ui_open(const string&in title) {
	if (show_window(title) is null) {
		ui_speak("could not open a window");
		return false;
	}
	return true;
}

// Keep the window's event loop alive and report whether the user asked to
// stop. show_window's own note says the window does no event processing
// unless a loop runs, and wait() is that loop's heartbeat. The Alt+F4
// spelling is the engine manual's own: keyboard_modifiers & KEYMOD_ALT with
// key_pressed(KEY_F4).
//
// The stop test is written out here rather than delegating to stop_key() in
// nvmidi_ui_keys.nvgt, and that is measured: AngelScript gives every included
// file its own compilation unit, so this helper cannot see a symbol from a
// file the *including* script pulled in - the same rule the pragma below
// exists for. A script that included only this file failed with "No matching
// symbol 'stop_key'" on the ui_pump line. The two spellings below match
// nvmidi_ui_keys.nvgt exactly, so both paths mean the same key.
bool ui_pump() {
	wait(5);
	if (key_pressed(KEY_ESCAPE)) return false;
	return !((keyboard_modifiers & KEYMOD_ALT) > 0 && (key_pressed(KEY_F4) || key_repeating(KEY_F4)));
}

// Plays a group of notes in the background, while the caller keeps running.
// With step_ms > 0 each note starts step_ms after the one before it (an
// arpeggio or a scale); with step_ms <= 0 they all start together (a chord).
// Either way a note is held for its own length. on_frame, if given, runs on
// every turn of the loop, which is where the caller updates its own things.
// Returns true once every note has finished, false if Alt+F4 cut it short.
//
// This drives send_note_on / send_note_off from its own clock instead of
// calling play_chord and watching get_active_notes(). That is deliberate and
// measured: the plugin has no timer that releases a non waiting play_chord,
// so get_active_notes() stays non zero for ever after one. Read in
// src/nvmidi.cpp, and confirmed on the engine - it was still 1 a full second
// after a 200 millisecond chord. A real background player has to schedule its
// own releases, which is what this does.
bool ui_play_background(midi_output@ synth, array<midi_note@>@ notes,
		double step_ms = 0.0, ui_tick@ on_frame = null) {
	const int count = int(notes.length());
	if (count == 0) return true;
	array<double> off_at;
	for (int i = 0; i < count; i++) off_at.insert_last(-1.0);
	const double start = ticks();
	int next_on = 0;
	int pending = 0;
	while (next_on < count || pending > 0) {
		const double elapsed = ticks() - start;
		// Every note whose moment has arrived, this frame.
		while (next_on < count) {
			const double at = (step_ms > 0.0) ? (next_on * step_ms) : 0.0;
			if (elapsed + 0.0001 < at) break;
			midi_note@ n = notes[next_on];
			synth.send_note_on(n.channel, n.pitch, n.velocity);
			off_at[next_on] = at + n.duration_ms();
			pending++;
			next_on++;
		}
		// Every note whose length is over.
		for (int i = 0; i < count; i++) {
			if (off_at[i] < 0.0) continue;
			if (elapsed + 0.0001 < off_at[i]) continue;
			midi_note@ n = notes[i];
			synth.send_note_off(n.channel, n.pitch);
			off_at[i] = -1.0;
			pending--;
		}
		if (!ui_pump()) { synth.all_notes_off(); return false; }
		if (on_frame !is null) on_frame();
	}
	return true;
}

// No entry point, for the same reason examples/nvmidi_ui_keys.nvgt has none:
// this file is only ever #included, and every includer defines its own main().
// Compiled on its own - which the sweep does not do, because a header that
// declares its functions in the plugin's types cannot compile without the
// plugin - it answers "No entry point found", and that is the compile being
// asked for a program, not a fault in the file.
