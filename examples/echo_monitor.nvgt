// echo_monitor.nvgt - speak every message the input port sends. Escape stops.
// Reads messages two ways: a switch on the type, and an is_* question.

#include "../midi.nvgt"

midi_input@ keyboard;
midi_message m;

void say(const string&in text) {
	print(text + "\n");
	if (SCREEN_READER_AVAILABLE) screen_reader_speak(text, false);
}

string describe(const midi_message&in message) {
	switch (message.kind) {
	case MIDI_NOTE_ON:
		if (message.is_note_off) return "note off " + midi_message_note_name_text(message);
		return "note on " + midi_message_note_name_text(message) + ", velocity " + message.data2;
	case MIDI_NOTE_OFF:
		return "note off " + midi_message_note_name_text(message);
	case MIDI_CONTROL_CHANGE:
		return "controller " + message.controller + " value " + message.data2;
	case MIDI_PROGRAM_CHANGE:
		return "program " + message.program;
	case MIDI_CHANNEL_PRESSURE:
		return "channel pressure " + message.channel_pressure;
	case MIDI_PITCH_BEND:
		return "pitch bend " + message.pitch_bend;
	case MIDI_POLY_AFTERTOUCH:
		return "aftertouch " + message.aftertouch + " on " + midi_message_note_name_text(message);
	}
	return midi_message_text(message);
}

void main() {
	show_window("nvmidi - echo");

	if (midi_input_port_count() == 0) {
		say("No MIDI input ports. Plug the keyboard in first.");
		return;
	}

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@keyboard = midi_input_create();
	if (!keyboard.open_config(config, "nvmidi echo")) {
		say("Cannot open " + midi_config_text(config) + ": " + midi_last_error_text());
		return;
	}
	say("Listening on " + midi_input_name_text(keyboard) + ". Play. Escape stops.");

	while (!key_pressed(KEY_ESCAPE)) {
		while (keyboard.next_message(m)) {
			if (m.is_pedal) // the is_* way: one question, said in words
				say("pedal, controller " + m.controller + " value " + m.data2);
			else
				say(describe(m));
		}
		wait(5);
	}
	keyboard.close();
}
