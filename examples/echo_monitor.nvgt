// echo_monitor.nvgt - speaks everything your keyboard sends. Escape quits.
// Handy for finding out what a knob, pedal or key actually sends.

#include "../midi.nvgt"

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

// Turns a message into a sentence.
string describe(const midi_message&in message) {
	switch (message.kind) {
	case MIDI_NOTE_ON:
		// Some keyboards release a key by sending "note on" with velocity 0.
		if (message.is_note_off) return "note off " + midi_message_note_name_text(message);
		return "note on " + midi_message_note_name_text(message) + ", velocity " + message.data2;
	case MIDI_NOTE_OFF:
		return "note off " + midi_message_note_name_text(message);
	case MIDI_CONTROL_CHANGE:
		if (message.is_pedal) return "pedal " + message.controller + ", value " + message.data2;
		return "controller " + message.controller + ", value " + message.data2;
	case MIDI_PROGRAM_CHANGE:
		return "program " + message.program;
	case MIDI_PITCH_BEND:
		return "pitch bend " + message.pitch_bend;
	case MIDI_CHANNEL_PRESSURE:
		return "channel pressure " + message.channel_pressure;
	case MIDI_POLY_AFTERTOUCH:
		return "aftertouch " + message.aftertouch + " on " + midi_message_note_name_text(message);
	}
	return midi_message_text(message); // anything else: let the plugin describe it
}

void main() {
	show_window("nvmidi - echo monitor");

	if (midi_input_port_count() == 0) {
		say("No MIDI input found. Plug in your keyboard first.");
		return;
	}

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	midi_input@ keyboard = midi_input_create();
	if (!keyboard.open_config(config, "echo monitor")) {
		say("Cannot open the input: " + midi_last_error_text());
		return;
	}
	say("Listening on " + midi_input_name_text(keyboard) + ". Play something. Escape quits.");

	midi_message message;
	while (!key_pressed(KEY_ESCAPE)) {
		// Read everything that has arrived since the last time around.
		while (keyboard.next_message(message)) {
			say(describe(message));
		}
		wait(5);
	}
	keyboard.close();
}
