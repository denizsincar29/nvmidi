// nvgt loads this plugin only when the script asks for it by name: without
// the pragma below the engine never opens the library and every midi_* name
#pragma plugin nvmidi

// One byte, back as a one-character string. This engine's string(byte) gives
// the decimal digits of the number rather than the character they stand for -
// measured on a windows runner, where the backend name came out of the byte
// pair as "110118109105100105..." and every comparison against "Windows"
// failed.
//
// A table walked with substr() does not work either, and that is measured too:
// index 32 answers 'W', index 65 answers '-', index 47 answers 'l', and
// substr(67, 1) is already empty on a literal whose length() is 68. The offsets
// are not one constant, so what the engine is doing there is unmeasured; what
// is measured is that the first ten and first twenty six characters of a
// literal read correctly (find("1") is 1, find("A") is 10). That is all this
// branch needs: digits, A-Z and a-z come from those two ranges, the punctuation
// a backend name is made of is a plain branch, and nothing walks the table.
//
// Every bound is a number because a character literal here is a one character
// string, not a code: measured, `b >= '0'` is "No conversion from 'const
// string' to math type available".
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
string char_of(uint b) {
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	return ".";
}


// --- headless safety net -------------------------------------------------
// Measured on the engine: when a script calls screen_reader_speak on a machine
// with no screen reader attached, nvgt does not return from the call - the
// process dies with SIGABRT and nothing that follows runs. That makes every
// script in this repository untestable on a build machine, and it is a
// property of the caller's machine, not of the script.
//
// So the reader is not called at all: the scripts go straight to the engine's
// own dialog box, which speaks through whatever assistive technology is
// running and is readable by a person either way. The caller's machine decides
// how the text arrives, not the script - and on a build machine the script
// runs to the end instead of dying on its first announcement.
void announce(const string&in text) {
	// alert wants a title as its second argument; a bare call does not
	// compile against this engine (measured: "No matching signatures to
	// 'alert(string)'").
	alert(text, "nvmidi");
}

// echo_monitor.nvgt - speak every message a MIDI device sends.
//
// The quickest way to confirm input works end to end. Play a few notes, turn
// a knob, move the pitch wheel, and listen to what arrives.
//
// The port comes from midi_config.txt next to this script, so pointing it at
// another keyboard is a matter of editing that file.
//
// Press escape to stop.

// The plugin hands its strings over as a count plus an indexed byte - see the
// readme. These put them back together here, where the engine's own strings
// were measured alive.
string bytes_of_config(midi_config@ c) {
	string s = "";
	for (int i = 0; i < c.describe_byte_count(); i++) {
		int b = c.describe_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) {
		int b = midi_last_error_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_port_name(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_input_port_name(midi_input@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}

// One line of text for a message that came in by reference. This is the pair
// scripts/e2e_midi.nvgt has used all along and that compiles on this engine;
// a midi_message handle in this position is what it refuses.
string bytes_of_message(const midi_message&in m) {
	string s = "";
	for (int i = 0; i < midi_message_name_byte_count(m); i++) {
		int b = midi_message_name_byte(m, i);
		s += char_of(b);
	}
	return s;
}

void main() {
	if (midi_input_port_count() == 0) {
		announce("No MIDI input ports. Plug the keyboard in first.");
		return;
	}

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.txt");

	midi_input@ keyboard = midi_input_create();
	if (!keyboard.open_config(config, "nvmidi echo")) {
		announce("Cannot open " + bytes_of_config(config) + ": " + bytes_of_last_error());
		return;
	}
	announce("Listening on " + bytes_of_input_port_name(keyboard));

	while (!key_pressed(KEY_ESCAPE)) {
		// A handle, not a value: the engine turns a value argument into a copy
		// of a POD type here, and a copy is what it asks for an opAssign
		// behaviour on - "No appropriate opAssign method found in
		// 'midi_message' for value assignment" is the engine's own words for
		// that. A handle is never copied. The pointer is good until the next
		// call, which is this loop's lifetime.
		midi_message@ m = keyboard.next_message_handle();
		while (m !is null) {
			// One line per message, spoken. bytes_of_message(m) already reads
			// like "note on, channel 1, note 60, velocity 100".
			announce(bytes_of_message(m));
			m = keyboard.next_message_handle();
		}
		wait(5);
	}

	keyboard.close();
	announce("Stopped.");
}
