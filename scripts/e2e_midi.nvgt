// nvgt loads this plugin only when the script asks for it by name: without
// the pragma below the engine never opens the library and every midi_* name
// is unknown to the compiler. That is exactly how the first ci run of this
// script failed, so the line is the first thing in the file on purpose.
#pragma plugin nvmidi

// One byte, back as a one-character string. This engine's string(byte) gives
// the decimal digits of the number rather than the character they stand for -
// measured on a windows runner, where the backend name came out of the byte
// pair as "110118109105100105..." and every comparison against "Windows"
// failed. A 64-letter table indexed by the byte is the conversion that works;
// string() is the one that reads well in a byte list and is wrong in a string.
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
string char_of(uint b) {
	if (b < byte_letters.length()) return byte_letters.substr(b, 1);
	return "?";
}


// e2e_midi.nvgt - the whole plugin, exercised once, with the console as the
// only microphone.
//
// Why this is not one of the examples
// ----------------------------------
//
// The examples announce through the engine's alert box, which is the right
// choice for a person: it speaks through whatever screen reader they run and
// it does not kill the process on a machine that has none. It is the wrong
// choice for a build machine, where there is nobody to press the button that
// dismisses the box and no reader to hear it. Every line an example says is
// therefore invisible in a ci log, and "the example ran" and "the example
// died in its first function" look exactly alike.
//
// This script says everything with print(), so the log carries each step as
// it happens and a run that stops early names where.
//
// What it proves, in order
// ------------------------
//
//   1. the library loads and registers        "LOADED <backend>"
//   2. a real ALSA sequencer client exists    "OUTPUT PORTS <n>"
//      - on a machine with no ALSA this is 0 and the script says so and stops
//   3. this process can publish its own port  "MADE PORT"
//      - the port a keyboard on the other end would play into; the engine
//        itself becomes the instrument
//   4. it accepts a connection and reads     "HEARD <message>"
//      - a note is sent in from another process and read out of the queue.
//        This is the one assertion that cannot be satisfied by the plugin
//        lying: the bytes arrive from outside it.
//   5. it can send                          "SENT", "OUTPUT OK"
//   6. and the whole high level layer runs   "PLAYED <pattern>"
//
// Step 4 needs a client on the other side; the ci job creates one with
// scripts/e2e_send.py, a second process that connects to the published port
// by name and plays a note into it. When nothing connects, the wait ends by
// itself and the script reports a failure - a silent pass would be
// indistinguishable from a plugin that opens ports and then reads none.

// --- the harness -----------------------------------------------------------

int failures = 0;

void ok(const string&in what) {
	print("E2E_OK " + what);
}

void fail(const string&in what) {
	print("E2E_FAIL " + what);
	failures++;
}

void note(const string&in what) {
	print("E2E_NOTE " + what);
}

// A machine with no midi bus at all. This is a different outcome from a
// plugin that opens a port and then hears nothing from it, and the caller has
// to be able to tell the two apart: the first is the runner's kernel, the
// second is a bug. Only the listener below knows which has happened, so it
// says it out loud before stopping, and the ci job reads that line.
bool have_bus = true;

// --- 1. the library --------------------------------------------------------

string bytes_of_object_port_name(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_object_port_name(midi_input@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_port_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_output_port_name_byte_count(port); i++) {
		int b = midi_output_port_name_byte(port, i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_input_port_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_input_port_name_byte_count(port); i++) {
		int b = midi_input_port_name_byte(port, i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) {
		int b = midi_last_error_byte(i);
		s += char_of(b);
	}
	return s;
}
