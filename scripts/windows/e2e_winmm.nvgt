// e2e_winmm.nvgt - the send half of the plugin, exercised on windows.
//
// The question this answers
// -------------------------
//
// The alsa job answers "can this process hear a real port". On windows that
// question has a different shape, and the shape comes from the platform, not
// from the plugin: winmm's midi api has no virtual ports at all. RtMidi's
// winmm backend says so in as many words - openVirtualPort is a comment, a
// warning and no code - so a windows build cannot publish a port for another
// process to find, and a test that waited for one would wait for something
// that cannot exist.
//
// What does exist on windows is the other direction, and it is the one a user
// actually cares about here: the plugin opens a port belonging to something
// else and writes to it, and the bytes land in that something else. The
// something else in the testing job is winmm itself - a program that owns a
// midi output port is exactly what a synthesiser, a loopback cable or the
// Microsoft GS wavetable synth is, and the machine has one of those because
// windows ships with it.
//
// So: this process plays. Another process listens. Nothing here can be faked
// by the plugin printing a line, because the assertion lives in the other
// process's log.
//
// What it proves, in order
// ------------------------
//
//   1. the library loads and registers          "E2E_OK LOADED <backend>"
//   2. the backend is a real one                "E2E_OK BACKEND <backend>"
//      - a dummy build passes this script and is worthless: it opens nothing.
//      - fails loudly, because the release artefact is the dummy one and this
//        job is the proof that the winmm build exists and works.
//   3. midi api is winmm, not something else    "E2E_OK SEND SIDE"
//   4. something else owns a port               "E2E_OK PORTS <n>"
//   5. we can open it                           "E2E_OK OPENED <name>"
//   6. and write a known melody to it           "E2E_SENT sequence"
//
// Step 6 is the point. The listener is told the port, connects, and logs every
// message it receives with its timestamp; the ci job then asserts that every
// note this script played arrived, in order, at the right millisecond under
// the right channel. Neither process can produce that log alone.

#pragma plugin nvmidi

// One byte, back as a one-character string. This engine's string(byte) gives
// the decimal digits of the number rather than the character they stand for -
// measured on a windows runner, where the backend name came out of the byte
// pair as "110118109105100105..." and every comparison against "Windows"
// failed.
//
// The table walk that replaced it was measured wrong too, and by then the
// runner had spent four runs saying only "the rebuilt text is wrong". Both
// halves of the old walk fail on this engine, each for its own reason:
//
//   byte_letters.substr(b, 1)   is not the character at b. Measured: index 32
//                               answers 'W', index 65 answers '-', index 47
//                               answers 'l', and substr(67, 1) is already empty
//                               on a literal whose length() is 68 - so the reads
//                               are wrong characters in range, nothing at all
//                               above roughly the midpoint, and the last
//                               character is out of reach.
//   byte_letters.length()       answers 68 for a 68 character literal: right
//                               here, and relied on below.
//   byte_letters.find(one)      was used to look one character up instead, and
//                               an earlier probe blamed it for answering 0 for
//                               every character. That blame was wrong and the
//                               same probe disproved it: find() answers 1 for
//                               "1", 10 for "A", 62 for "/" and -1 for a miss.
//
// The offsets in that first line are not one constant - 32 to 'W' and 65 to '-'
// are not the same shift - so the mechanism behind them is still unmeasured and
// is deliberately not claimed here. What is claimed is what the branch below
// does: it never walks the table, and the ranges it reads are the first ten and
// the first twenty six characters of a literal, which this engine does read
// correctly (measured: find("1") is 1 and find("A") is 10, and the rebuilt name
// below came back off the runner as "nvmidi/Windows MultiMedia").
//
// So the table is walked by substr() nowhere, and the one case this file
// actually needs - ascii letters, digits and the punctuation a backend name is
// made of - is a spelled out branch. Uppercase, lowercase and digits are the
// three ranges measured to convert, and every bound is a number.
//
// The default is a '.' and not the '?' the old walk used. A question mark is
// what a console font draws for a byte it cannot print, so a backend name full
// of them reads as a rendering problem; a dot is unmistakably this function
// saying it has no mapping for that byte, and it is printable as itself.
// Character literals are not numbers here. Measured: `b >= '0'` is
// "No conversion from 'const string' to math type available" - in this engine
// '0' is a one character string, not the code 48. Every bound below is
// therefore the number itself, with the character it stands for in the comment,
// so the comparison never asks the engine to do the conversion it refuses.
//
// '0' 48  '9' 57   |  'A' 65  'Z' 90  |  'a' 97  'z' 122
// '/' 47  '.' 46  '_' 95  '-' 45  '+' 43  ' ' 32
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
string char_of(uint b) {
	// 48..57, the digits. Handed back by code, not by the table the engine
	// cannot read out: a table built here could not be indexed safely either.
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	// 65..90, A..Z.
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	// 97..122, a..z.
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	// The punctuation a windows backend name is made of, each one literal.
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	// Anything else, said as itself rather than as a console artefact.
	return ".";
}

// --- the harness -----------------------------------------------------------
//
// print() rather than alert(), for the reason the alsa script gives: a
// headless runner has no reader and no hand for a message box, and "the
// script ran" and "the script died on its first call" look alike when every
// word of it goes into a dialog nobody opens. There is a transcript here
// instead.

// --- case insensitive matching ---------------------------------------------
//
// The engine's string type carries find() and substr() but no case folding at
// all: `to_lowercase` is "No matching symbol" and the angelscript add-ons
// vendored here define nothing of the kind either. Port names are compared
// against fixed words ("loopmidi", the job's hint) that arrive in whatever case
// the driver and the workflow happen to use, so the comparison is folded by
// hand here rather than by a call that does not exist.
//
// Only ascii is folded, which is the whole of the alphabet these names use.
// The comparison this feeds is a substring test against fixed words, and a
// string comes back from the source already as a string - so the whole of
// the folding is done here, once, rather than per character at every call
// site. Two earlier attempts are recorded because each failed for a
// different reason and the reasons are the engine's, not this file's:
//
//     const uint c = folded[i];        indexing yields a string, not a byte
//                                      "Can't implicitly convert from
//                                       'const string' to 'uint'"
//     out[i] = c + 32;                 `out` is a reserved keyword here
//
// So the folded copy is built from substr() pieces and the character
// comparison is done with find() on a one-character string, which is the
// only string comparison this engine is known to parse.
string lower_first(const string&in one) {
	if (one.length() == 0) return one;
	const string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	const string lower = "abcdefghijklmnopqrstuvwxyz";
	const int at = upper.find(one);
	if (at < 0) return one;
	return lower.substr(at, 1);
}

string fold_case(const string&in text) {
	string folded = "";
	for (uint i = 0; i < text.length(); i++) {
		folded += lower_first(text.substr(i, 1));
	}
	return folded;
}

bool matches_ignoring_case(const string&in haystack, const string&in needle) {
	if (needle.length() == 0) return false;
	return fold_case(haystack).find(fold_case(needle)) >= 0;
}

int failures = 0;

void ok(const string&in what) {
	print("E2E_OK " + what);
}

void fail(const string&in what) {
	print("E2E_FAIL " + what);
	failures++;
}

void note(const string&in what) {
	print("E2E_NOTE " + what);
}

// --- the melody ------------------------------------------------------------
//
// Six notes with a distinctive shape, so that a listener's log can be matched
// against it note by note rather than counted. The last three deliberately
// repeat the first three an octave down: a listener that reads a stale buffer
// or a plugin that replays its own queue produces a run that is the right
// length and the wrong shape, and this catches that without needing a
// checksum.

// Dynamic arrays filled from a literal, because of a measured compilation
// failure rather than by preference. Two forms were tried and both were
// rejected by the engine, each with the same two words at the declaration:
//
//     uint g_note[NOTES] = {...};   with NOTES a `const uint`
//     uint g_note[6]     = {...};   with a plain integer literal
//
//     ERROR: Expected '('    ERROR: Instead found '['
//
// The linux script and the examples never declare a fixed size array at all -
// they write `string[]@ x = {...}` and `array<T>@ x = array<T>()` - so those
// are the two shapes known to compile, and this is the first of them.
uint[]@ g_note = {60, 64, 67, 48, 52, 55};
uint[]@ g_vel = {100, 90, 80, 70, 60, 50};
// ms between the starts of consecutive events, and ms a note is held.
// A hundred and fifty is long enough to survive a scheduler hiccup on a
// shared runner and short enough that the whole run is under a second.
const uint GAP_MS = 150;
const uint HOLD_MS = 100;

// The plugin's strings arrive as a length plus an indexed byte, measured -
// see the readme. These read that protocol back into a script string.
string bytes_of_output_port_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_output_port_name_byte_count(port); i++) {
		int b = midi_output_port_name_byte(port, i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) {
		int b = midi_last_error_byte(i);
		s += char_of(b);
	}
	return s;
}
string bytes_of_last_error_as_numbers() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) {
		if (i > 0) s += ",";
		s += midi_last_error_byte(i);
	}
	return s;
}
string bytes_of_object_port_name(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) {
		int b = o.get_port_name_byte(i);
		s += char_of(b);
	}
	return s;
}

void main() {
	print("E2E_BEGIN");

	// The two lists have to describe the same run, and a mismatch would be
	// read as a timing fault further down, so it is named here where it is.
	// The count is taken from the melody rather than written beside it: a
	// constant that drifted from the list it sizes would make the timing
	// check below measure the wrong interval without ever saying so.
	if (g_note.length() != g_vel.length()) {
		fail("the melody has " + g_note.length() + " notes and " + g_vel.length() + " velocities, so the two lists do not describe the same run");
		print("E2E_END failures=" + failures);
		return;
	}
	const uint NOTES = g_note.length();
	// Read by the listener, which is already looking for this line: the port
	// name below is deterministic (winmm ports are), but the *number* the
	// plugin addresses them by is not, and the listener needs the name.
	print("nvmidi e2e winmm is open");

	// A name to prefer, handed in by the job. The runner this runs on has no
	// loopback driver - measured, not assumed - so the port that is actually
	// there is the synth windows ships with, and the job passes its name in
	// rather than this file hard coding a vendor string that differs between
	// windows versions and locales.
	// The hint arrives in the environment, and that is a repair rather than a
	// preference. It used to arrive as the word after `--hint` on the command
	// line, and the engine refused to start at all: measured on run
	// 36571447467, `Unknown option specified: hint`, exit code 78, and an
	// empty stdout because the script had not been read yet. Anything that
	// begins with a dash belongs to the engine's own option parser, and it is
	// consulted before the script exists - so no spelling of a flag can work
	// here, and `--` does not fence it off either.
	//
	// The environment has no such parser in front of it. `read_environment_
	// variable` is registered by the engine itself (src/pocostuff.cpp, the
	// Environment block), so this is a published api and not a guess; the name
	// it reads is set by the job step.
	//
	// COMMAND_LINE is still read as a fallback, one bare word with no dash in
	// front of it, because a person running this by hand has no environment to
	// set and needs a way in. Nothing here asserts what that word will be when
	// the engine is launched by a path: the attempt that would have measured it
	// never ran, so the fallback is written to be harmless when it is absent
	// and the print below is what says which of the two answered.
	string hint = read_environment_variable("NVGT_E2E_HINT");
	if (hint == "") {
		const string[]@ words = COMMAND_LINE.split(" ");
		for (uint i = 0; i < words.length(); i++) {
			// Not named `word`: this engine's string(uint) is the array
			// constructor, and a local called word shadows it for the whole
			// function - which turns `string(...)` into a sized array of empty
			// strings further down, 26 and 30 characters long by accident.
			string candidate = words[i].trim_whitespace();
			if (candidate.length() == 0) continue;
			if (candidate.find("-") != -1) continue;
			if (candidate.find(".nvgt") != -1) continue;
			if (candidate.find("\\") != -1 || candidate.find("/") != -1) continue;
			hint = candidate;
			break;
		}
	}
	if (hint != "") print("E2E_HINT " + hint);

	// The backend name, and the exact numbers it arrived as.
	//
	// Two shapes deliberately, and the second one is the point. Rebuilding the
	// text is what the rest of this file does, and it is what a person wants to
	// read - but it is also the half that was measured wrong on this runner
	// twice, once as the decimal digits of every byte and once as 25 question
	// marks, while the numbers underneath were right both times. A count and a
	// list of numbers cannot be bent by a local shadowing a constructor, by a
	// substring, or by a table: the job decodes them on its own side, where the
	// engine is not in the way at all. So the translation stops being evidence
	// and becomes prose, and the verdict is taken from the numbers.
	const int API_BYTES = midi_api_name_byte_count();
	print("E2E_API_BYTES " + API_BYTES);
	string api_numbers = "";
	for (int i = 0; i < API_BYTES; i++) {
		if (i > 0) api_numbers += ",";
		api_numbers += midi_api_name_byte(i);
	}
	print("E2E_API_NUMBERS " + api_numbers);
	if (API_BYTES == 0) {
		fail("midi_api_name returned nothing, so the plugin is not registered");
		print("E2E_END failures=" + failures);
		return;
	}

	// The control that used to sit here is gone, and its answer is why. It
	// built 25 characters out of two literals, alternating "8" and "7", and
	// this engine reconstructed that text as 87 repeated - every character
	// right and every position wrong. It was worth printing while the fault it
	// was measuring was unmeasured, and it is answered: the fault was the wrong
	// conversion for a byte (string(byte) gives its decimal digits) and the
	// substr() table walk that was the first attempt at replacing it, both
	// written up in PROBE-FINDINGS.md. The control compares a builder that
	// never worked against a plugin, and the builder works now.
	//
	// What is kept is the number the control was there to protect: the bytes,
	// printed raw, so a regression in the plugin is visible as itself before
	// the text is read at all.
	// Printed before the bytes are read, not after.
	//
	// The line below the old order read the name one byte per call through
	// char_of(), and char_of() is midi_api_name_byte in the plugin: it crosses
	// the engine's own call boundary. Measured on the runner, that boundary is
	// what takes the process down - a six line script whose only fault is a
	// string literal ahead of a handle declaration dies on its first call with
	// no output buffered, while the identical script without the call runs. So
	// the marker is a separate print, first in this block, and every reading
	// after it is a line the job can lose rather than a block it never sees.
	print("E2E_LOADED_MARKER");
	string api = "";
	for (int i = 0; i < API_BYTES; i++) api += char_of(midi_api_name_byte(i));
	ok("LOADED " + api);

	// What the bytes were read as here. The job compares this against what it
	// decoded itself from E2E_API_NUMBERS: when the two disagree the fault is
	// in this side's rebuilding and not in the boundary, and when they agree
	// the verdict can be taken with confidence. Printed either way, because the
	// line that would have given this away was the one missing for two runs.
	print("E2E_API_TEXT " + api);

	// Every stop below is decided on the numbers, never on the rebuilt text.
	//
	// Not a stylistic choice: `api` is a script string, and a script string in
	// this engine has already been measured twice reporting something other
	// than the bytes it was built from. A verdict that ends the script on
	// `api.find(...)` inherits exactly the fault this file just stopped
	// trusting, and the run it kills is a run that never prints the port list
	// the job needs.
	//
	// So the question is put to the bytes themselves, as find() calls on a
	// string that was built from them and nothing else. Three earlier forms of
	// this loop are gone and each one was measured wrong on the runner rather
	// than reasoned about:
	//
	//   "ndows"[k]                a compile error - indexing a string does not
	//                             give a number
	//   byte_letters.find(one)    was blamed for answering 0 for every
	//                             character, and that blame was wrong: probed
	//                             on the runner, find("Q") on a literal with no
	//                             Q in it answers -1, tbl.find("~") answers -1
	//                             and tail.substr(0,1) has length 1 and equals
	//                             "n". find() was never the fault.
	//   char_of(c).find(one)      same call, same non-fault
	//
	// What the same probe did leave standing is char_of() itself: the control
	// beside this block renders its text and answers find("87") with 0, while
	// the string built from the plugin's bytes is wrong character for
	// character. The conversion is the fault, so the next run asks about the
	// conversion directly (scripts/windows/char_of_probe.nvgt) instead of
	// asking about the search.
	//
	// What is left is the form that was never in doubt: find() on an argument
	// long enough to be a real substring. It answers with an index or -1,
	// measured, and both of those are usable.
	const string api_from_bytes = api;
	print("E2E_API_FIND_WINDOWS " + api_from_bytes.find("Windows"));
	print("E2E_API_FIND_DUMMY " + api_from_bytes.find("Dummy"));
	// -1 is what find() answers for a string that is not there, and it is a
	// plain integer comparison - not a one-character string passed anywhere.
	const bool is_winmm = api_from_bytes.find("Windows") >= 0 || api_from_bytes.find("WINDOWS") >= 0;
	const bool is_dummy = api_from_bytes.find("Dummy") >= 0 || api_from_bytes.find("DUMMY") >= 0;

	// The dummy backend compiles, loads, registers, opens nothing and prints
	// every line below this one. That is the failure mode this whole job
	// exists to catch, so it is a failure here, not a note.
	if (is_dummy) {
		fail("the backend is Dummy: it will open no port and deliver no note, so nothing this script claims would be true");
		print("E2E_END failures=" + failures);
		return;
	}
	if (!is_winmm) {
		fail("expected a windows midi backend, got " + api + ": this script and its listener only make sense against winmm");
		print("E2E_END failures=" + failures);
		return;
	}
	ok("BACKEND " + api);

	// --- what this machine offers ------------------------------------------
	//
	// Enumerated before anything is opened, and printed in full, because the
	// listener has to be given a port by name and this is the only place the
	// names exist. A runner with no midi output at all says 0 here, and that
	// is the machine's shape rather than the plugin's bug - the same
	// distinction the alsa script draws around E2E_NO_BUS.
	const uint outs = midi_output_port_count();
	print("E2E_OUTPUT_PORTS " + outs);
	for (uint i = 0; i < outs; i++) {
		print("E2E_OUTPUT_PORT " + i + " " + bytes_of_output_port_name(i));
	}

	// --- pick one -----------------------------------------------------------
	//
	// The order is deliberate. A virtual port cannot exist on this platform,
	// so a build that believes it made one is lying; and a real device port is
	// what a user's keyboard is. Loopback first, then a synth, then whatever
	// is there - the runner is a windows machine, so the fallback always
	// matches something, and the name in the log says which was chosen.
	int chosen = -1;
	string chosen_name = "";
	for (uint i = 0; i < outs; i++) {
		const string n = bytes_of_output_port_name(i);
		if (chosen < 0) chosen = int(i);
		// Case insensitive without a lower-case helper: the engine has no
		// to_lowercase on string (measured - "No matching symbol 'to_lowercase'"
		// at this line), and port names differ from the job's hint in case on
		// some windows builds, so an exact find() would silently pick the wrong
		// port and the listener would hear nothing.
		if (chosen_name == "" && hint != "" && matches_ignoring_case(n, hint)) {
			chosen = int(i);
			chosen_name = n;
		}
		if (chosen_name == "" && (matches_ignoring_case(n, "loopbe") || matches_ignoring_case(n, "loopmidi")
			|| matches_ignoring_case(n, "virtual") || matches_ignoring_case(n, "loop"))) {
			chosen = int(i);
			chosen_name = n;
		}
	}
	if (chosen < 0) {
		print("E2E_NO_BUS no midi output port exists on this machine, so nothing can be played into anything");
		note("the machine has no midi out at all: the runner's configuration, not the plugin's behaviour");
		print("E2E_END failures=" + failures);
		return;
	}
	if (chosen_name == "") chosen_name = bytes_of_output_port_name(chosen);
	ok("PORTS " + outs);
	ok("CHOSEN " + chosen_name);

	// --- open it ------------------------------------------------------------
	midi_output@ port = midi_output_create();
	if (!port.open(chosen, "nvmidi e2e windows")) {
		// The numbers first, then the text, because the text is the half that
		// has been measured wrong twice on this runner - once as the decimal
		// digits of every byte and once as a run of question marks - while the
		// numbers underneath were right both times.
		//
		// The whole enumeration is repeated here rather than assumed from the
		// lines above. The failure can happen at a port the *listen* half also
		// has to open, and this line is the only place that names every entry
		// as this process saw it in one unbroken run of tokens: the port this
		// run cannot open is frequently the port the other process owns, and
		// "MMRESULT 1" alone cannot tell an absent device from a busy one.
		fail("cannot open output port " + chosen + " (" + chosen_name + ")");
		print("E2E_OPEN_FAILED index=" + chosen
			+ " text_bytes=" + midi_last_error_byte_count()
			+ " error_numbers=" + bytes_of_last_error_as_numbers()
			+ " outs=" + midi_output_port_count()
			+ " model=" + bytes_of_output_port_name(chosen));
		print("E2E_END failures=" + failures);
		return;
	}
	ok("OPENED " + bytes_of_object_port_name(port));
	// Handed to the listener, which needs it for its own open() call and gets
	// it from this line rather than from winmm's numbering order, which is not
	// guaranteed to match the enumeration above under two processes.
	print("E2E_PORT " + chosen_name);

	// --- the send half of the api -------------------------------------------
	//
	// Every write call the plugin has, not just note on/off, and the listener
	// checks all of them. A backend that drops one class of message is a real
	// bug - the winmm path goes through one packed word per message, and the
	// packing is where that kind of drop happens.
	port.send_note_on(0, g_note[0], g_vel[0]);
	port.send_note_off(0, g_note[0], 0);
	port.send_control_change(0, 7, 100);
	port.send_control_change(0, 10, 64);
	port.send_program_change(0, 24);
	port.send_pitch_bend(0, 8192);
	port.send_sysex("\\xF0\\x7E\\x7F\\x09\\x01\\xF7");
	note("wrote one of each message class before the melody, so the listener can check them all");

	// --- the melody ---------------------------------------------------------
	//
	// Timed by the engine's own clock rather than by sleeping: the whole point
	// of the listener's timestamps is that it can tell a note played on time
	// from a note played in a burst at the end, and that comparison needs the
	// sender to have actually spaced them.
	//
	// The interval is sent to the listener as a line of its own before the
	// first note, which is what makes the comparison possible without either
	// side guessing. 60 is middle C; the engine's clock is milliseconds.
	print("E2E_GAP " + GAP_MS + " " + HOLD_MS);
	uint start = ticks();
	for (uint i = 0; i < NOTES; i++) {
		const uint due = start + i * GAP_MS;
		while (ticks() < due) wait(1);
		port.send_note_on(0, g_note[i], g_vel[i]);
		uint off_due = ticks() + HOLD_MS;
		while (ticks() < off_due) wait(1);
		port.send_note_off(0, g_note[i], 0);
		print("E2E_NOTE_SENT " + i + " " + g_note[i] + " " + g_vel[i] + " at " + (ticks() - start));
	}
	print("E2E_SENT sequence");
	// The engine's own millisecond clock is the instrument for those numbers,
	// so a clock that does not advance would make every event look
	// simultaneous. Reported rather than assumed.
	const uint elapsed = ticks() - start;
	if (elapsed < (NOTES - 1) * GAP_MS) {
		fail("the melody took " + elapsed + " ms, which is less than its own spacing: the engine clock did not advance and the timing in the listener's log is not evidence of anything");
	}

	if (port.is_open()) ok("OUTPUT OK " + bytes_of_object_port_name(port));
	else fail("the output port reports itself closed right after sending");

	// --- the high level layer, playing out of the same port -----------------
	//
	// play_chord_wait opens the port at a given index and plays through it. If
	// it does not open, the chord is reported as a failure rather than skipped:
	// this is the call every example in the repository uses.
	if (port.open(chosen, "nvmidi e2e windows")) {
		array<midi_note@>@ chord = array<midi_note@>();
		uint[]@ chord_pitches = {60, 64, 67};
		for (uint i = 0; i < 3; i++) {
			midi_note@ n = nvmidi_note_create(chord_pitches[i]);
			n.velocity = 100;
			n.length = midi_duration(100, MIDI_MS);
			chord.insert_last(@n);
		}
		if (port.play_chord_wait(chord)) ok("PLAYED chord");
		else fail("play_chord_wait refused: " + bytes_of_last_error());

		string[]@ patterns = {"chord", "spread", "arpeggio", "quick", "fast", "strum", "repeat"};
		for (uint i = 0; i < patterns.length(); i++) {
			if (port.play_midi_chord_wait(chord, patterns[i])) ok("PLAYED " + patterns[i]);
			else fail("pattern " + patterns[i] + " refused: " + bytes_of_last_error());
		}
		// The listener counts what arrives; these came through the same port as
		// the melody, so its total is a lower bound on how many of the notes
		// above actually left the process.
		note("played the chord in seven schemes through the same port");
	} else {
		fail("cannot reopen the port for the chord: " + bytes_of_last_error());
	}

	// A moment for the last note to leave the port before the process exits:
	// winmm's queue is drained by the driver, not by us, and a process that
	// goes away immediately can take an undelivered message with it. Long
	// enough to cover a runner under load, short enough not to look like a
	// hang if it is the last thing in the job.
	wait(1500);

	port.close();
	print("E2E_END failures=" + failures);
	// The count is the summary and the job greps for it, the same contract the
	// alsa script has: the engine's exit code is about the engine.
}
