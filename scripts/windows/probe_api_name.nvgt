// probe_api_name.nvgt - a control for the byte protocol on a windows runner.
//
// This file was written when the plugin's strings were suspected of being
// mangled somewhere between RtMidi's object file and the script. It ran, and
// answered a larger question than it asked: one process read the api name both
// ways, in the same second, and got
//
//     byte path    nvmidi/Windows MultiMedia  (25 bytes, exact)
//     string path  0u??z               (garbage)
//
// so the fault is not in RtMidi and not in this plugin's own string building.
// It is the return slot itself: the engine publishes no string factory, and a
// plugin that hands back a string writes into memory the engine is not
// expecting. Every string surface in this plugin is now a byte pair.
//
// What is left here is the smallest reproducible check of that: a length, the
// bytes as decimal numbers, and the script rebuilding the text on its own side
// where literals and concatenation were measured alive. Kept because it is the
// cheapest way to re-confirm the protocol after an engine update - if a future
// engine grows a string factory, the warning in register_nvmidi() fires and
// this is the run that shows whether returning strings has started working.
//
// The byte count below is the answer as much as the text is: 30 is
// "Microsoft GS Wavetable Synth 0", the only output the WinMM backend has, and
// any other number means the boundary is broken again.

#pragma plugin nvmidi

// One byte, back as a one-character string. This engine's string(byte) gives
// the decimal digits of the number rather than the character they stand for -
// measured on a windows runner, where the backend name came out of the byte
// pair as "110118109105100105..." and every comparison against "Windows"
// failed.
//
// A table walked with substr() does not work either, and that is measured too:
// index 32 answers 'W', index 65 answers '-', index 47 answers 'l', and
// substr(67, 1) is already empty on a literal whose length() is 68. The offsets
// are not one constant, so what the engine is doing there is unmeasured; what
// is measured is that the first ten and first twenty six characters of a
// literal read correctly (find("1") is 1, find("A") is 10). That is all this
// branch needs: digits, A-Z and a-z come from those two ranges, the punctuation
// a backend name is made of is a plain branch, and nothing walks the table.
//
// Every bound is a number because a character literal here is a one character
// string, not a code: measured, `b >= '0'` is "No conversion from 'const
// string' to math type available".
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
string char_of(uint b) {
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	return ".";
}


// `out` is a reserved keyword in this engine - "ERROR: Instead found reserved
// keyword 'out'" at the declaration, measured on the runner, not guessed. It
// cost this probe two runs that looked like plugin failures and were compile
// errors, which is why the accumulator below is named `hex` and not `out`.
// keyword 'out'" at the declaration, measured on the runner, not guessed. It
// cost this probe two runs that looked like plugin failures and were compile
// errors. Kept here so the next person writing a loop in this engine does not
// pay for it again; nothing below uses a loop variable called `out`.

void main() {
	print("PROBE_BEGIN");
	fflush();
	// Every line from here down is a number or a literal. No value that came
	// out of the plugin is ever concatenated, measured, or indexed, because
	// that is what killed the two earlier probes at -1073740791
	// (STATUS_STACK_BUFFER_OVERRUN) before they could print once.
	//
	// The plugin's port name is now handed over as bytes and the script
	// rebuilds the string on its own side, where literals and concatenation
	// were measured alive. Whether a plugin-returned string can work at all is
	// the question this run answers, and the answer will be in the length
	// below: 30 is the real name, anything else is a mismatch.
	const int n = midi_output_port_name_byte_count(0);
	print("PROBE_BYTE_COUNT " + n);
	// The bytes as decimal, one per line, so nothing here can depend on how
	// this engine handles a string of unknown provenance. Numbers out, numbers
	// printed.
	for (int i = 0; i < n && i < 64; i++) {
		print("PROBE_BYTE " + i + " " + midi_output_port_name_byte(0, i));
	}
	print("PROBE_BYTES_END");
	// nvgt_plugin_version() was tried here and is not a symbol this engine has
	// - "ERROR: No matching symbol 'nvgt_plugin_version'", measured on the
	// runner, which cost the probe a third run. The engine's export list is
	// its own, and these numbers are what this file was written to read.
	//
	// The api name, read the same way through the byte pair, and this time the
	// script rebuilds the text on its own side - where literals and
	// concatenation were measured alive - so the line below is a readable
	// answer and not a byte list. The string method of the same name is still
	// registered during this run; if its value and this one disagree, the
	// string path is corrupt and the byte path is not, in one run, for the
	// same underlying number.
	const int an = midi_api_name_byte_count();
	print("PROBE_API_BYTES " + an);
	string api = "";
	for (int i = 0; i < an && i < 128; i++) {
		int b = midi_api_name_byte(i);
		api += char_of(b);
	}
	print("PROBE_API_TEXT " + api);
	print("PROBE_END");
}
