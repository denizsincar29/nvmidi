// e_call compiles the plugin call:   int b = midi_api_name_byte_count();  exit 0
// f_open does not:                   midi_output@ port_out = midi_output_create();  exit 65
//   ...and then points nothing at it.
//
// The difference between the two lines is not the call, it is the left-hand
// side. So put the plugin's name on the left of a declaration, declare it
// nothing to do with anything, and point nothing at it. If this exits 65 the
// engine is refusing the TYPE as a declaration, before any plugin code runs.
#pragma plugin nvmidi

void main() {
	print("H_BEGIN");
	midi_output@ h = null;
	print("H_DONE");
}
