// Does a script that declares a handle type still compile?
//
// The question this file answers is about the build, not about the plugin's
// behaviour: a handle type in a script body is refused by the parser before
// anything runs, and the refusal reads as a plugin defect. Every e2e script
// here declares one, so if the parser has started refusing them, every e2e
// script dies the same way and the crash cannot be read as a runtime fault.
//
// It is also a control for this file's own shape: e2e_types.nvgt is the same
// body without the two handle declarations. If that one runs and this one does
// not, the handle declaration is the difference and nothing else is.
#pragma plugin nvmidi

void main() {
	print("H_BEGIN");
	midi_output@ out = null;
	print("H_ONE " + (out is null));
	midi_input@ in = null;
	print("H_TWO " + (in is null));
	print("H_END");
}
