// char_of2_probe.nvgt - does the spelled out conversion actually convert?
//
// The first char_of probe named the fault: byte_letters.substr(b, 1) is not
// the character at b on this engine. It answered index 0 with '6' and index 1
// with '8' - the two characters swapped and every one after them shifted - and
// answered empty from the length onwards, so the old walk lost everything but
// its first two characters and its last few.
//
// This file runs the replacement, copied in, on the bytes that matter. It does
// not read the plugin, so a failure here is an engine fact and a pass here is
// permission to believe the e2e script's rebuilt name.
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
// Character literals are not numbers here: `b >= '0'` is "No conversion from
// 'const string' to math type available". Every bound is the number itself.
string char_of(uint b) {
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	return ".";
}

// The backend name, as the plugin hands it over: 25 decimal numbers.
void main() {
	print("C2_BEGIN");
	const int COUNT = 25;
	// No array here, and that is measured three times over. `int bytes[25] =
	// {...}` is rejected as "Expected '(' / Instead found identifier 'bytes'".
	// `int bytes[25];` on its own is rejected the same way. And so is `int
	// bytes[];` - run 36556894828, line 39 column 6, the same two errors. This
	// engine refuses a local array to a function that has a plugin loaded, so
	// the twenty five numbers are plain locals and the loop reads them through
	// a chain of comparisons instead.
	int b00 = 110; int b01 = 118; int b02 = 109; int b03 = 105;
	int b04 = 100; int b05 = 105; int b06 = 47; int b07 = 87;
	int b08 = 105; int b09 = 110; int b10 = 100; int b11 = 111;
	int b12 = 119; int b13 = 115; int b14 = 32; int b15 = 77;
	int b16 = 117; int b17 = 108; int b18 = 116; int b19 = 105;
	int b20 = 77; int b21 = 101; int b22 = 100; int b23 = 105;
	int b24 = 97;
	string s = "";
	for (int i = 0; i < COUNT; i++) {
		uint b = 0;
		if (i == 0) b = b00; else if (i == 1) b = b01; else if (i == 2) b = b02;
		else if (i == 3) b = b03; else if (i == 4) b = b04; else if (i == 5) b = b05;
		else if (i == 6) b = b06; else if (i == 7) b = b07; else if (i == 8) b = b08;
		else if (i == 9) b = b09; else if (i == 10) b = b10; else if (i == 11) b = b11;
		else if (i == 12) b = b12; else if (i == 13) b = b13; else if (i == 14) b = b14;
		else if (i == 15) b = b15; else if (i == 16) b = b16; else if (i == 17) b = b17;
		else if (i == 18) b = b18; else if (i == 19) b = b19; else if (i == 20) b = b20;
		else if (i == 21) b = b21; else if (i == 22) b = b22; else if (i == 23) b = b23;
		else b = b24;
		s += char_of(b);
	}
	print("C2_API_TEXT " + s);
	print("C2_API_LEN " + s.length());
	// The two questions the e2e script asks of this text. Both were -1 while
	// the text was wrong; both are the numbers the job is waiting for.
	print("C2_FIND_WINDOWS " + s.find("Windows"));
	print("C2_FIND_DUMMY " + s.find("Dummy"));
	// Each character the name is made of, one per line, so a single wrong cell
	// is visible as itself instead of as a whole name.
	print("C2_CHARS " + char_of(110) + char_of(118) + char_of(109) + char_of(105) + char_of(100)
		+ char_of(47) + char_of(87) + char_of(32) + char_of(77) + char_of(65) + char_of(97) + char_of(48));
	print("C2_END");
}
