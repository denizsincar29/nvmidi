// The plugin's types, one per line, each announced before it is touched.
// Whatever the process dies on, the last MIN_* line in the log names it.
#pragma plugin nvmidi

void main() {
	print("MIN_BEGIN");
	print("MIN_API");
	int bytes = midi_api_name_byte_count();
	print("MIN_API_DONE " + bytes);
	print("MIN_PORT_COUNT");
	uint outs = midi_output_port_count();
	print("MIN_PORT_COUNT_DONE " + outs);
	print("MIN_PORT_CREATE");
	print("MIN_DECL_OUT");
	midi_output@ o = midi_output_create();
	print("MIN_PORT_CREATE_DONE");
	print("MIN_DURATION");
	print("MIN_DECL_D");
	midi_duration@ d = midi_duration_create(100, MIDI_MS);
	print("MIN_DURATION_DONE");
	print("MIN_NOTE");
	print("MIN_DECL_N");
	midi_note@ n = midi_note_create(60);
	print("MIN_NOTE_DONE");
	print("MIN_END");
}
