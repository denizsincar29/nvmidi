// Every name the plugin registers, asked for as a declared type in a script
// that makes no call at all. c_handle shows that a declaration of the output
// type is refused with "Expected ';'" / "Instead found '@'", and k_lit shows
// that the same declaration with a built in type is accepted. This probe says
// which of the registered names the engine actually has as types.
#pragma plugin nvmidi

void main() {
	print("N_BEGIN");
	string s;
	int i = 0;
	double d = 0;
	midi_message m;
	midi_duration u;
	print("N_MIDI_MESSAGE_DONE");
	print("N_MIDI_DURATION_DONE");
	midi_note@ n = null;
	print("N_MIDI_NOTE_DONE");
	midi_config@ c = null;
	print("N_MIDI_CONFIG_DONE");
	midi_input@ in_port = null;
	print("N_MIDI_INPUT_DONE");
	midi_output@ out_port = null;
	print("N_MIDI_OUTPUT_DONE");
	print("N_END " + s + i + d);
}
