#include "midi.nvgt"

// test_config.nvgt - end to end smoke test of midi_config: the match and port
// members, load, load_if_present, find_input_port, find_output_port,
// get_last_port, describe and get_path, and that a missing file is reported
// rather than fatal. One line per check, printed and appended to apitest.log.
//
// Run it from a directory that holds midi_config.txt (match=zzzznope, port=1)
// and midi_config_named.txt (match=nord, port=0). Ports on the test machine:
// inputs 0 MOTU M Series MIDI In 0, 1 Nord Piano 6 MIDI 1; outputs 0 Microsoft
// GS Wavetable Synth 0, 1 MOTU M Series MIDI Out 1, 2 Nord Piano 6 MIDI 2.
//
// main() opens output port 2 once and closes it at the end. If it cannot be
// opened the check logs a FAIL and every API check still runs. There is no
// startup cue: a test should make only the sound it asserts on.


int g_pass = 0;
int g_fail = 0;

string bstr(bool b) { if (b) return "true"; return "false"; }

void check(const string&in name, bool ok, const string&in detail) {
	string verdict = ok ? "PASS" : "FAIL";
	string line = "TEST " + name + " " + verdict + " " + detail;
	file_put_contents("apitest.log", line + "\n", true);
	print(line + "\n");
	if (ok) g_pass += 1;
	else g_fail += 1;
}

void main() {
	file_put_contents("apitest.log", "", false);

	// -- open output port 2 once for the checks below ---------------------
	midi_output@ cue = midi_output_create();
	bool cue_open = cue.open(uint(2));
	if (!cue_open) {
		check("output_open_port2", false, "cannot open output port 2: " + midi_last_error_text());
	} else {
		check("output_open_port2", true, "opened output port 2");
	}

	midi_config@ cfg = midi_config_create();
	check("config_default_port_0", cfg.port == 0, "port=" + cfg.port);
	cfg.port = 1;
	check("config_port_settable", cfg.port == 1, "port=" + cfg.port);

	// -- load a real file (fallback path: nothing matches, port=1) ---------
	bool load_fb = cfg.load("midi_config.txt");
	check("config_load_file_returns_true", load_fb, "returned=" + bstr(load_fb) + " error=" + midi_last_error_text());
	int fb_in = cfg.find_input_port();
	check("config_fallback_find_input_port_1", fb_in == 1, "found=" + fb_in);
	check("config_fallback_get_last_port_1", cfg.get_last_port() == 1, "last_port=" + cfg.get_last_port());
	check("config_fallback_describe_doc", midi_config_text(cfg) == "Nord Piano 6 MIDI 1 (fallback port 1)", "text=" + midi_config_text(cfg));
	int fb_out = cfg.find_output_port();
	check("config_fallback_find_output_port_1", fb_out == 1, "found=" + fb_out + " text=" + midi_config_text(cfg));

	// -- load_if_present: a missing file is not fatal ----------------------
	bool ifp_missing = cfg.load_if_present("no_such_file_zzz.txt");
	check("config_load_if_present_missing_returns_false", !ifp_missing, "returned=" + bstr(ifp_missing));
	check("config_load_if_present_missing_no_error", midi_last_error_byte_count() == 0, "last_error=" + midi_last_error_text());
	bool ifp_present = cfg.load_if_present("midi_config.txt");
	check("config_load_if_present_present_returns_true", ifp_present, "returned=" + bstr(ifp_present) + " error=" + midi_last_error_text());

	// -- load: a missing file is an error ----------------------------------
	bool load_missing = cfg.load("no_such_file_zzz.txt");
	check("config_load_missing_returns_false", !load_missing, "returned=" + bstr(load_missing));
	check("config_load_missing_reports_error", midi_last_error_byte_count() > 0, "last_error=" + midi_last_error_text());

	// -- a config that matches by name -------------------------------------
	midi_config@ cfg2 = midi_config_create();
	bool load_named = cfg2.load("midi_config_named.txt");
	check("config_named_load_returns_true", load_named, "returned=" + bstr(load_named) + " error=" + midi_last_error_text());
	int named_in = cfg2.find_input_port();
	check("config_named_find_input_port_1", named_in == 1, "found=" + named_in + " text=" + midi_config_text(cfg2));
	check("config_named_describe_doc", midi_config_text(cfg2) == "Nord Piano 6 MIDI 1", "text=" + midi_config_text(cfg2) + " last_port=" + cfg2.get_last_port());
	int named_out = cfg2.find_output_port();
	check("config_named_find_output_port_2", named_out == 2, "found=" + named_out);
	check("config_named_output_describe_doc", midi_config_text(cfg2) == "Nord Piano 6 MIDI 2", "text=" + midi_config_text(cfg2) + " last_port=" + cfg2.get_last_port());

	// -- get_path ----------------------------------------------------------
	check("config_get_path_bytes", cfg2.get_path_byte_count() == 21 && midi_config_path_text(cfg2) == "midi_config_named.txt", "count=" + cfg2.get_path_byte_count() + " path=" + midi_config_path_text(cfg2));

	// -- the members set from the script -----------------------------------
	cfg2.match = "motu";
	cfg2.port = 0;
	int motu_in = cfg2.find_input_port();
	check("config_script_match_motu_input_0", motu_in == 0, "found=" + motu_in + " text=" + midi_config_text(cfg2));
	int motu_out = cfg2.find_output_port();
	check("config_script_match_motu_output_1", motu_out == 1, "found=" + motu_out + " text=" + midi_config_text(cfg2));

	// -- reading the match member back (a string crossing out) -------------
	string match_read = cfg2.match;
	check("config_match_member_read", match_read == "motu", "value=" + match_read);

	cue.all_notes_off();
	cue.close();

	string result = "RESULT pass=" + g_pass + " fail=" + g_fail;
	file_put_contents("apitest.log", result + "\n", true);
	print(result + "\n");
	return;
}
