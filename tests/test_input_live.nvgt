#pragma plugin nvmidi

// test_input_live.nvgt - the half of the transport no build machine can reach:
// a byte that comes out of a real instrument and through the queue.
//
// The three other tests in this folder play everything themselves and never
// need a person. This one does, so it says so out loud, with one signal:
//
//   C E G E an octave below middle C  - your turn, play the instrument
//
// That low ripple is kept deliberately. Дениз asked for it on 2026-10-01,
// having sat through tests that beeped without ever telling him whether he
// was supposed to be playing. There is no separate high startup ripple any
// more - it was decoration, and the low one is the only signal a person needs.
//
// What it measures: every message the instrument sends, and the note an octave
// up coming back out of it - the feature this plugin was written for. Whether
// the synthesised note is audible is the one thing this file cannot check; the
// reading of it is the person's.
//
// Run it from any directory; it writes apitest.log beside itself.

const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
string char_of(uint b) {
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	if (b == 40) return "(";
	if (b == 41) return ")";
	return ".";
}

int g_pass = 0;
int g_fail = 0;

string bstr(bool b) { if (b) return "true"; return "false"; }

void check(const string&in name, bool ok, const string&in detail) {
	string verdict = ok ? "PASS" : "FAIL";
	string line = "TEST " + name + " " + verdict + " " + detail;
	file_put_contents("apitest.log", line + "\n", true);
	print(line + "\n");
	if (ok) g_pass += 1;
	else g_fail += 1;
}

string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) s += char_of(midi_last_error_byte(i));
	return s;
}
string bytes_of_input_port(midi_input@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) s += char_of(o.get_port_name_byte(i));
	return s;
}
string bytes_of_output_port(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) s += char_of(o.get_port_name_byte(i));
	return s;
}

// C E G E, one note at a time. octave = 0 puts it on middle C, octave = -1 an
// octave below, which is the "your turn" signal.
void ripple(midi_output@ mo, int octave, int velocity) {
	int lo = octave * 12;
	mo.send_note_on(1, 60 + lo, velocity); wait(60); mo.send_note_off(1, 60 + lo, 0);
	mo.send_note_on(1, 64 + lo, velocity); wait(60); mo.send_note_off(1, 64 + lo, 0);
	mo.send_note_on(1, 67 + lo, velocity); wait(60); mo.send_note_off(1, 67 + lo, 0);
	mo.send_note_on(1, 64 + lo, velocity); wait(60); mo.send_note_off(1, 64 + lo, 0);
	mo.all_notes_off();
}

void main() {
	file_put_contents("apitest.log", "", false);
	print("LIVE_START\n");

	midi_output@ mo = midi_output_create();
	if (!mo.open(2)) {
		check("live_open_output", false, "cannot open output port 2: " + bytes_of_last_error());
		return;
	}
	check("live_open_output", true, bytes_of_output_port(mo));

	midi_input@ mi = midi_input_create();
	if (!mi.open(1)) {
		check("live_open_input", false, "cannot open input port 1: " + bytes_of_last_error());
		mo.close();
		return;
	}
	check("live_open_input", true, bytes_of_input_port(mi));
	check("live_input_ignore_sysex_default", mi.get_ignore_sysex() == true, "ignore_sysex=" + bstr(mi.get_ignore_sysex()));
	check("live_input_ignore_timing_default", mi.get_ignore_timing() == true, "ignore_timing=" + bstr(mi.get_ignore_timing()));

	// Your turn. An octave down, three times, so it is impossible to miss and
	// impossible to confuse with the cue above.
	wait(300);
	ripple(mo, -1, 110);
	wait(700);
	ripple(mo, -1, 110);
	print("LIVE_PLAY_NOW play the instrument for 30 seconds\n");

	uint heard = 0;
	uint notes_on = 0;
	uint echoed = 0;
	bool saw_pending = false;
	const uint until = ticks() + 30000;
	while (ticks() < until) {
		if (mi.get_pending() > 0) saw_pending = true;
		midi_message m;
		while (mi.next_message(m)) {
			heard++;
			print("LIVE_MSG " + m.status + " " + m.data1 + " " + m.data2 + "\n");
			uint command = m.status & 0xf0;
			int n = m.data1 + 12;
			if (n > 127) n -= 12;
			if (command == 0x90 && m.data2 > 0) {
				mo.send_note_on(1, n, m.data2);
				notes_on++;
				echoed++;
				print("LIVE_ECHO note on " + m.data1 + " -> " + n + "\n");
			} else if (command == 0x80 || (command == 0x90 && m.data2 == 0)) {
				mo.send_note_off(1, n, m.data2);
				echoed++;
			}
		}
		wait(5);
	}

	check("live_has_message_seen", saw_pending, "get_pending() was above zero at least once");
	check("live_messages_heard", heard > 0, "heard=" + heard);
	check("live_note_ons", notes_on > 0, "note_on=" + notes_on);
	check("live_echoed_events", echoed > 0, "echoed=" + echoed);
	check("live_queue_empty_at_end", mi.get_pending() == 0 || heard > 0, "pending=" + mi.get_pending());

	mo.all_notes_off();
	mo.close();
	mi.close();

	// Your turn is over: the same low ripple, once, is the pair to the "play"
	// signal.
	midi_output@ bye = midi_output_create();
	if (bye.open(2)) { ripple(bye, -1, 110); bye.close(); }

	string result = "RESULT pass=" + g_pass + " fail=" + g_fail;
	file_put_contents("apitest.log", result + "\n", true);
	print(result + "\n");
	print("LIVE_END\n");
}
