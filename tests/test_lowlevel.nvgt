#pragma plugin nvmidi

// test_lowlevel.nvgt - end to end smoke test of every midi_output method and
// of the plugin's free functions. One line per check, printed and appended to
// apitest.log in the current directory, so a run that dies still leaves
// evidence. Playback is routed to output port 2 (the Nord); sound is expected
// and nothing is asserted about what is audible.
//
// main() opens port 2 once and reuses that object for the checks below, so the
// port is opened only once. If it cannot be opened the check logs a FAIL and
// every API check still runs. There is no startup cue: a test should make only
// the sound it asserts on.

// A whole byte back as one character. Only the ranges this engine reads
// correctly are used, and every bound is a number - see TECHNICAL.md.
const string byte_letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/._-+ ";
const string digits = "0123456789";
string char_of(uint b) {
	if (b >= 48 && b <= 57) return digits.substr(b - 48, 1);
	if (b >= 65 && b <= 90) return byte_letters.substr(b - 65 + 10, 1);
	if (b >= 97 && b <= 122) return byte_letters.substr(b - 97 + 36, 1);
	if (b == 47) return "/";
	if (b == 46) return ".";
	if (b == 95) return "_";
	if (b == 45) return "-";
	if (b == 43) return "+";
	if (b == 32) return " ";
	// The plugin does emit brackets - a fallback description is
	// "MOTU ... (fallback port 0)" - and without these two lines the
	// reconstruction turns them into dots and every comparison against a
	// bracketed string fails for a reason that is not the plugin.
	if (b == 40) return "(";
	if (b == 41) return ")";
	return ".";
}

int g_pass = 0;
int g_fail = 0;

string bstr(bool b) { if (b) return "true"; return "false"; }

void check(const string&in name, bool ok, const string&in detail) {
	string verdict = ok ? "PASS" : "FAIL";
	string line = "TEST " + name + " " + verdict + " " + detail;
	file_put_contents("apitest.log", line + "\n", true);
	print(line + "\n");
	if (ok) g_pass += 1;
	else g_fail += 1;
}

string bytes_of_input_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_input_port_name_byte_count(port); i++) s += char_of(midi_input_port_name_byte(port, i));
	return s;
}
string bytes_of_output_name(uint port) {
	string s = "";
	for (int i = 0; i < midi_output_port_name_byte_count(port); i++) s += char_of(midi_output_port_name_byte(port, i));
	return s;
}
string bytes_of_api_name() {
	string s = "";
	for (int i = 0; i < midi_api_name_byte_count(); i++) s += char_of(midi_api_name_byte(i));
	return s;
}
string bytes_of_last_error() {
	string s = "";
	for (int i = 0; i < midi_last_error_byte_count(); i++) s += char_of(midi_last_error_byte(i));
	return s;
}
string bytes_of_first_error() {
	string s = "";
	for (int i = 0; i < midi_first_error_byte_count(); i++) s += char_of(midi_first_error_byte(i));
	return s;
}
string bytes_of_output_port(midi_output@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) s += char_of(o.get_port_name_byte(i));
	return s;
}
string bytes_of_input_port(midi_input@ o) {
	string s = "";
	for (int i = 0; i < o.get_port_name_byte_count(); i++) s += char_of(o.get_port_name_byte(i));
	return s;
}
string bytes_of_message(const midi_message&in m) {
	string s = "";
	for (int i = 0; i < midi_message_name_byte_count(m); i++) s += char_of(midi_message_name_byte(m, i));
	return s;
}

// The name of the note a message is about, off the message's own byte pair.
string bytes_of_note_name(const midi_message&in m) {
	string s = "";
	for (int i = 0; i < m.note_name_byte_count; i++) s += char_of(m.note_name_byte(i));
	return s;
}

// The name of a pitch, off the free function's byte pair.
string bytes_of_pitch_name(int pitch) {
	string s = "";
	for (int i = 0; i < midi_note_pitch_name_byte_count(pitch); i++) s += char_of(midi_note_pitch_name_byte(pitch, i));
	return s;
}


void main() {
	file_put_contents("apitest.log", "", false);

	uint p0 = 0; uint p1 = 1; uint p2 = 2; uint pbad = 99;

	// -- open output port 2 once; every check below reuses this object ----
	midi_output@ mo = midi_output_create();
	bool cue_open = mo.open(p2);
	if (!cue_open) {
		check("output_open_port2", false, "cannot open output port 2: " + bytes_of_last_error());
	} else {
		check("output_open_port2", true, "opened output port 2 " + bytes_of_output_port(mo));
	}

	// -- a fresh engine, before any call can fail -------------------------
	check("first_error_initially_empty", midi_first_error_byte_count() == 0, "count=" + midi_first_error_byte_count() + " text=" + bytes_of_first_error());

	// -- free functions: counts, names, search ---------------------------
	int inputs = int(midi_input_port_count());
	int outputs = int(midi_output_port_count());
	check("input_port_count", inputs == 2, "count=" + inputs);
	check("output_port_count", outputs == 3, "count=" + outputs);

	check("input_port0_name_bytes", midi_input_port_name_byte_count(p0) == 23, "count=" + midi_input_port_name_byte_count(p0) + " name=" + bytes_of_input_name(p0));
	check("input_port1_name_bytes", midi_input_port_name_byte_count(p1) == 19, "count=" + midi_input_port_name_byte_count(p1) + " name=" + bytes_of_input_name(p1));
	check("output_port0_name_bytes", midi_output_port_name_byte_count(p0) == 30, "count=" + midi_output_port_name_byte_count(p0) + " name=" + bytes_of_output_name(p0));
	check("output_port1_name_bytes", midi_output_port_name_byte_count(p1) == 24, "count=" + midi_output_port_name_byte_count(p1) + " name=" + bytes_of_output_name(p1));
	check("output_port2_name_bytes", midi_output_port_name_byte_count(p2) == 19, "count=" + midi_output_port_name_byte_count(p2) + " name=" + bytes_of_output_name(p2));
	check("input_port_name_out_of_range_count", midi_input_port_name_byte_count(pbad) == 0, "count=" + midi_input_port_name_byte_count(pbad));
	check("input_port_name_out_of_range_byte", midi_input_port_name_byte(pbad, p0) == -1, "byte=" + midi_input_port_name_byte(pbad, p0));
	check("api_name_bytes_nonempty", midi_api_name_byte_count() > 0, "count=" + midi_api_name_byte_count() + " name=" + bytes_of_api_name());

	check("find_input_port_nord", midi_find_input_port("nord") == 1, "found=" + midi_find_input_port("nord"));
	check("find_input_port_missing", midi_find_input_port("zzzznope") == -1, "found=" + midi_find_input_port("zzzznope"));
	check("find_output_port_nord", midi_find_output_port("nord") == 2, "found=" + midi_find_output_port("nord"));
	check("find_output_port_missing", midi_find_output_port("zzzznope") == -1, "found=" + midi_find_output_port("zzzznope"));

	// -- midi_output: the cue already opened it; check that state ---------
	midi_output@ fresh = midi_output_create();
	check("output_create_closed_port", fresh.get_port() == -1, "port=" + fresh.get_port());
	check("output_pedals_fresh_zero", fresh.sustain == 0 && fresh.sostenuto == 0 && fresh.soft == 0, "sustain=" + fresh.sustain + " sostenuto=" + fresh.sostenuto + " soft=" + fresh.soft);
	check("output_create_not_open", !fresh.is_open(), "is_open=" + bstr(fresh.is_open()));
	check("output_open_port2_after_open", mo.is_open() && mo.get_port() == 2, "is_open=" + bstr(mo.is_open()) + " port=" + mo.get_port());
	check("output_is_open", mo.is_open(), "is_open=" + bstr(mo.is_open()));
	check("output_get_port", mo.get_port() == 2, "port=" + mo.get_port());
	check("output_port_name_bytes", mo.get_port_name_byte_count() == 19, "count=" + mo.get_port_name_byte_count() + " name=" + bytes_of_output_port(mo));
	check("output_port_name_first_byte", mo.get_port_name_byte(p0) == 78, "byte=" + mo.get_port_name_byte(p0));
	check("last_error_after_open", midi_last_error_byte_count() == 0, "count=" + midi_last_error_byte_count());

	// -- raw sending ------------------------------------------------------
	bool sraw = mo.send(uint(0x90), uint(60), uint(100));
	check("send_raw_note_on", sraw, "returned=" + bstr(sraw) + " error=" + bytes_of_last_error());
	wait(400);
	bool soff = mo.send(uint(0x80), uint(60), uint(0));
	check("send_raw_note_off", soff, "returned=" + bstr(soff) + " error=" + bytes_of_last_error());
	wait(400);
	bool spacked = mo.send_packed(uint(6570128)); // note on, E4, velocity 100 - a different key, so the ear hears notes and not a buzz
	check("send_packed_note_on", spacked, "returned=" + bstr(spacked) + " error=" + bytes_of_last_error());
	mo.send(uint(0x80), uint(64), uint(0));
	wait(250);

	// -- helper sends (void): a success is an empty last_error ------------
	mo.send_note_on(1, 60, 100);
	check("send_note_on", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	wait(400); // space the note events out: this block used to fire them all in one go and machine-gunned middle C
	mo.send_note_off(1, 60);
	check("send_note_off", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	wait(400); // space the note events out: this block used to fire them all in one go and machine-gunned middle C
	mo.send_control_change(1, 7, 100);
	check("send_control_change", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	wait(250); // space the note events out: this block used to fire them all in one go and machine-gunned middle C
	mo.send_program_change(1, 1);
	check("send_program_change", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	wait(250); // space the note events out: this block used to fire them all in one go and machine-gunned middle C
	mo.send_pitch_bend(1, 8192);
	check("send_pitch_bend", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	wait(250); // space the note events out: this block used to fire them all in one go and machine-gunned middle C
	mo.send_aftertouch(1, 60, 64);
	check("send_aftertouch", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	wait(250); // space the note events out: this block used to fire them all in one go and machine-gunned middle C
	mo.send_channel_pressure(1, 64);
	check("send_channel_pressure", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	wait(250); // space the note events out: this block used to fire them all in one go and machine-gunned middle C
	mo.send_sysex("\xF0\x7E\x7F\x09\x01\xF7");
	check("send_sysex", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	wait(250); // space the note events out: this block used to fire them all in one go and machine-gunned middle C
	mo.all_notes_off();
	check("all_notes_off", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	mo.reset();
	check("reset", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());

	// -- pedals: the properties the user asked for ------------------------
	// mo is open on port 2, so each assignment is a real control change on
	// the wire, not only a number kept on the object. Every value is put
	// back to 0 before the next one, so no pedal is left holding the tests
	// that follow.
	mo.sustain = 100;
	check("output_sustain_holds_assigned", mo.sustain == 100, "sustain=" + mo.sustain);
	check("output_sustain_assign_no_error", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	mo.sustain = 0;
	mo.sostenuto = 127;
	check("output_sostenuto_holds_assigned", mo.sostenuto == 127, "sostenuto=" + mo.sostenuto);
	check("output_sostenuto_assign_no_error", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	mo.sostenuto = 0;
	mo.soft = 64;
	check("output_soft_holds_assigned", mo.soft == 64, "soft=" + mo.soft);
	check("output_soft_assign_no_error", midi_last_error_byte_count() == 0, "last_error=" + bytes_of_last_error());
	mo.soft = 0;
	wait(250); // space the pedal events out, as the note events above are spaced

	// -- tempo and duration() on the output class -------------------------
	mo.tempo = 96.0;
	check("output_tempo_roundtrip", mo.tempo == 96.0, "tempo=" + mo.tempo);
	double beat96 = mo.duration(1.0, MIDI_BEATS).to_ms();
	check("output_duration_beats_at_96", beat96 > 624.9 && beat96 < 625.1, "to_ms=" + beat96);
	double ms250 = mo.duration(250.0, MIDI_MS).to_ms();
	check("output_duration_ms_passthrough", ms250 == 250.0, "to_ms=" + ms250);

	// -- what the high level layer is holding -----------------------------
	uint stopped = mo.stop_all_notes();
	check("output_stop_all_notes_idle", int(stopped) == 0, "returned=" + stopped);
	uint active = mo.get_active_notes();
	check("output_get_active_notes_idle", int(active) == 0, "active=" + active);

	// -- midi_message fields and name -------------------------------------
	midi_message m;
	m.status = uint8(0x90); m.data1 = uint8(60); m.data2 = uint8(100); m.channel = 1;
	check("midi_message_fields", int(m.status) == 144 && int(m.data1) == 60 && int(m.data2) == 100 && m.channel == 1, "status=" + int(m.status) + " data1=" + int(m.data1) + " data2=" + int(m.data2) + " channel=" + m.channel);
	check("midi_message_name_bytes", midi_message_name_byte_count(m) > 0, "count=" + midi_message_name_byte_count(m) + " text=" + bytes_of_message(m));

	// -- reading a message: the named accessors ---------------------------
	// The fields are writable, so every branch is exercised here without a
	// device: a message is built by hand and then asked what it is.
	check("msg_kind_note_on", m.kind == 0x90, "kind=" + m.kind);
	check("msg_is_note", m.is_note, "is_note=" + bstr(m.is_note));
	check("msg_is_note_on", m.is_note_on, "is_note_on=" + bstr(m.is_note_on));
	check("msg_is_note_on_false_for_off", !m.is_note_off, "is_note_off=" + bstr(m.is_note_off));
	check("msg_is_control_change_false", !m.is_control_change, "is_cc=" + bstr(m.is_control_change));
	check("msg_controller_not_a_cc", m.controller == -1, "controller=" + m.controller);
	check("msg_pedal_not_a_cc", !m.is_pedal && m.pedal_type == 0, "is_pedal=" + bstr(m.is_pedal) + " type=" + m.pedal_type);
	check("msg_pitch_bend_not_a_bend", m.pitch_bend == -1, "bend=" + m.pitch_bend);
	check("msg_program_not_a_pc", m.program == -1, "program=" + m.program);
	check("msg_note_name_is_c4", bytes_of_note_name(m) == "C4", "name=" + bytes_of_note_name(m));

	// A velocity-0 note on is a release. Hardware sends it under running
	// status, and counting it as a press is how a script holds a key down
	// forever.
	m.data2 = uint8(0);
	check("msg_velocity0_is_release", !m.is_note_on && m.is_note_off, "is_note_on=" + bstr(m.is_note_on) + " is_note_off=" + bstr(m.is_note_off));

	// An explicit note off, on channel 3 to prove the channel is not in kind.
	m.status = uint8(0x83); m.channel = 3;
	check("msg_note_off_explicit", m.is_note_off && !m.is_note_on && m.kind == 0x80, "kind=" + m.kind + " off=" + bstr(m.is_note_off));

	// A controller move of the sustain pedal.
	m.status = uint8(0xb0); m.data1 = uint8(64); m.data2 = uint8(127);
	check("msg_cc_sustain", m.is_control_change && m.controller == 64, "controller=" + m.controller);
	check("msg_pedal_sustain", m.is_pedal && m.pedal_type == 1, "type=" + m.pedal_type);
	m.data1 = uint8(66);
	check("msg_pedal_sostenuto", m.pedal_type == 2, "type=" + m.pedal_type);
	m.data1 = uint8(67);
	check("msg_pedal_soft", m.pedal_type == 3, "type=" + m.pedal_type);
	m.data1 = uint8(7); // volume - a controller, but not a pedal
	check("msg_cc_not_pedal", m.is_control_change && !m.is_pedal && m.controller == 7, "type=" + m.pedal_type + " controller=" + m.controller);

	// Pitch bend: 14 bits, least significant seven first, 8192 centred.
	m.status = uint8(0xe0); m.data1 = uint8(0); m.data2 = uint8(64);
	check("msg_pitch_bend_centre", m.pitch_bend == 8192, "bend=" + m.pitch_bend);
	m.data1 = uint8(127); m.data2 = uint8(127);
	check("msg_pitch_bend_max", m.pitch_bend == 16383, "bend=" + m.pitch_bend);
	m.data1 = uint8(0); m.data2 = uint8(0);
	check("msg_pitch_bend_min", m.pitch_bend == 0, "bend=" + m.pitch_bend);

	// Program change carries one data byte; channel pressure likewise.
	m.status = uint8(0xc0); m.data1 = uint8(42);
	check("msg_program", m.program == 42 && m.aftertouch == -1 && m.channel_pressure == -1, "program=" + m.program);
	m.status = uint8(0xd0); m.data1 = uint8(99);
	check("msg_channel_pressure", m.channel_pressure == 99, "pressure=" + m.channel_pressure);
	m.status = uint8(0xa0); m.data1 = uint8(60); m.data2 = uint8(70);
	check("msg_aftertouch", m.aftertouch == 70, "aftertouch=" + m.aftertouch);

	// The note name of a few pitches, through the plugin's own builder.
	check("msg_note_name_fsharp3", bytes_of_pitch_name(54) == "F#3", "name=" + bytes_of_pitch_name(54));
	check("msg_note_name_a5", bytes_of_pitch_name(81) == "A5", "name=" + bytes_of_pitch_name(81));

	// -- midi_output close and its failure model --------------------------
	mo.all_notes_off();
	mo.close();
	check("output_closed", !mo.is_open() && mo.get_port() == -1, "is_open=" + bstr(mo.is_open()) + " port=" + mo.get_port());
	bool bad = mo.open(pbad);
	check("output_open_bad_port_fails", !bad, "returned=" + bstr(bad));
	check("last_error_after_bad_open", midi_last_error_byte_count() > 0, "count=" + midi_last_error_byte_count() + " text=" + bytes_of_last_error());

	// -- open by name ------------------------------------------------------
	bool byname = mo.open_by_name("nord");
	check("output_open_by_name_nord", byname, "returned=" + bstr(byname) + " error=" + bytes_of_last_error());
	check("output_open_by_name_port", mo.get_port() == 2, "port=" + mo.get_port());
	mo.all_notes_off();
	mo.close();

	// -- midi_input: everything exercisable without a human playing --------
	midi_input@ mi = midi_input_create();
	check("input_create_closed_port", mi.get_port() == -1, "port=" + mi.get_port());
	check("input_pedals_fresh_zero", mi.sustain == 0 && mi.sostenuto == 0 && mi.soft == 0, "sustain=" + mi.sustain + " sostenuto=" + mi.sostenuto + " soft=" + mi.soft);
	bool iopened = mi.open(p1);
	check("input_open_port1", iopened, "returned=" + bstr(iopened) + " error=" + bytes_of_last_error());
	check("input_is_open", mi.is_open(), "is_open=" + bstr(mi.is_open()));
	check("input_get_port", mi.get_port() == 1, "port=" + mi.get_port());
	check("input_port_name_bytes", mi.get_port_name_byte_count() == 19, "count=" + mi.get_port_name_byte_count() + " name=" + bytes_of_input_port(mi));
	check("input_has_message_empty", !mi.has_message(), "has_message=" + bstr(mi.has_message()));
	check("input_get_pending_empty", int(mi.get_pending()) == 0, "pending=" + mi.get_pending());
	midi_message mm;
	bool got = mi.next_message(mm);
	check("input_next_message_empty_false", !got, "returned=" + bstr(got) + " error=" + bytes_of_last_error());
	mi.clear();
	check("input_clear_no_fault", true, "clear() returned");
	check("input_ignore_sysex_default_true", mi.get_ignore_sysex(), "value=" + bstr(mi.get_ignore_sysex()));
	check("input_ignore_timing_default_true", mi.get_ignore_timing(), "value=" + bstr(mi.get_ignore_timing()));
	mi.set_ignore_sysex(false);
	check("input_set_ignore_sysex_false", !mi.get_ignore_sysex(), "value=" + bstr(mi.get_ignore_sysex()));
	mi.set_ignore_sysex(true);
	mi.set_ignore_timing(false);
	check("input_set_ignore_timing_false", !mi.get_ignore_timing(), "value=" + bstr(mi.get_ignore_timing()));
	mi.set_ignore_timing(true);
	uint istop = mi.stop_all_notes();
	check("input_stop_all_notes_idle", int(istop) == 0, "returned=" + istop);
	uint iactive = mi.get_active_notes();
	check("input_get_active_notes_idle", int(iactive) == 0, "active=" + iactive);
	mi.tempo = 96.0;
	check("input_tempo_roundtrip", mi.tempo == 96.0, "tempo=" + mi.tempo);
	double ibeat = mi.duration(1.0, MIDI_BEATS).to_ms();
	check("input_duration_beats_at_96", ibeat > 624.9 && ibeat < 625.1, "to_ms=" + ibeat);
	mi.close();
	check("input_closed", !mi.is_open() && mi.get_port() == -1, "is_open=" + bstr(mi.is_open()) + " port=" + mi.get_port());
	bool ibad = mi.open(pbad);
	check("input_open_bad_port_fails", !ibad, "returned=" + bstr(ibad));

	check("first_error_nonempty_after_failures", midi_first_error_byte_count() > 0, "count=" + midi_first_error_byte_count() + " text=" + bytes_of_first_error());

	string result = "RESULT pass=" + g_pass + " fail=" + g_fail;
	file_put_contents("apitest.log", result + "\n", true);
	print(result + "\n");
	return;
}
