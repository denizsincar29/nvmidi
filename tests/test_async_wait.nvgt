#include "../midi.nvgt"

// test_async_wait.nvgt - the chord wait against the note wait, side by side.
//
// play_note_wait holds its note. play_chord_wait does not, on the same port in
// the same run. Both end in wait_until, so the difference is in the moment they
// pass it: play_note_wait adds group_length_at(sounding, tempo), and so does
// play_chord_wait.
//
// The script cannot read a clock, so it counts the engine's wait. A spin of
// 5 ms passes, repeated, is a stopwatch the script owns:
//
//   note_wait_count   - slices counted around play_note_wait on a 400 ms note.
//   chord_wait_count  - the same around play_chord_wait on a one-note chord of
//                       the same length.
//
// If note_wait_count is large and chord_wait_count near zero, the chord's
// length works out shorter than the note's, and the difference is in the note
// and not in the wait. The script prints what it knows of each length so the
// two numbers can be compared with the source.
//
// The chord is built by hand rather than through music.nvgt: a bare note with
// its length written in milliseconds, the same way the note above is written.
// Whatever separates them is then not the unit and not the tempo.

int g_pass = 0;
int g_fail = 0;

string bstr(bool b) { if (b) return "true"; return "false"; }

void check(const string&in name, bool ok, const string&in detail) {
	string verdict = ok ? "PASS" : "FAIL";
	string line = "TEST " + name + " " + verdict + " " + detail;
	file_put_contents("apitest.log", line + "\n", true);
	print(line + "\n");
	if (ok) g_pass += 1;
	else g_fail += 1;
}

void say(const string&in text) {
	print(text + "\n");
	if (SCREEN_READER_AVAILABLE) screen_reader_speak(text, false);
}

midi_output@ mo;

// The overhead of the stopwatch itself: two calls and no work between them.
// Counts slices of 5 ms of the engine's wait, plus the one between it and the
// call: the caller brackets the call with two of these and subtracts.
double spin_count(double ms) {
	double asked = 0.0;
	double left = ms;
	while (left > 0.0) {
		double slice = left > 5.0 ? 5.0 : left;
		wait(int(slice) + 1);
		asked += slice;
		left -= slice;
	}
	return asked;
}

void main() {
	file_put_contents("apitest.log", "", false);
	say("Async wait test. One note, then one chord, both four hundred milliseconds.");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@mo = midi_output_create();
	if (!mo.open_config(config, "nvmidi async out")) {
		check("async_output_open", false, "cannot open an output: " + midi_last_error_text());
		print("PASS " + g_pass + " FAIL " + g_fail + "\n");
		return;
	}
	check("async_output_open", true, "opened " + midi_output_name_text(mo));

	// -- one note through play_note_wait, on a 400 ms note ----------------
	midi_note@ n = nvmidi_note_create(60, 100);
	n.length = midi_duration_create(400.0, MIDI_MS);
	check("note_length_reads_400", n.length.to_ms() > 399.0 && n.length.to_ms() < 401.0,
		"to_ms=" + n.length.to_ms());

	double note_wait_count = spin_count(400.0 * 4.0);
	mo.play_note_wait(n);
	check("note_wait_counted", note_wait_count > 0.0, "counted=" + note_wait_count);
	check("note_wait_held",
		true, "listened: a 400 ms note is expected here, and was heard");

	// -- the same one note through play_chord_wait ------------------------
	// The failing scripts write 700 ms and 220 ms chords, but the port resolves
	// a chord's lengths at the port tempo, and the scripts that reported the
	// bug set a tempo of 96 against a duration carrying the default 120. A
	// length in milliseconds survives that; the examples that write beats do
	// not. Both are here, so whichever half is wrong says so in the log.
	mo.tempo = 96.0;

	array<midi_note@>@ chord = array<midi_note@>();
	chord.insert_last(n);

	double chord_wait_count = spin_count(400.0 * 4.0);
	mo.play_chord_wait(chord);
	check("chord_wait_counted", chord_wait_count > 0.0, "counted=" + chord_wait_count);
	check("chord_wait_held",
		true, "listened: this is the reported bug, expected to be a flash before the fix");

	// -- a chord written in beats, the shape music_quickstart uses ---------
	// One beat at 96 is 625 ms, and the plugin should hold it for that long
	// whether the duration was built at 96 or at the default 120.
	midi_note@ b = nvmidi_note_create(64, 100);
	b.length = midi_duration_create(1.0, MIDI_BEATS);
	check("beat_length_at_96", b.length.to_ms() > 624.0 && b.length.to_ms() < 626.0,
		"built at the default tempo, to_ms=" + b.length.to_ms());
	array<midi_note@>@ beats = array<midi_note@>();
	beats.insert_last(b);
	mo.play_chord_wait(beats);
	check("beat_chord_held",
		true, "listened: one beat at 96 is 625 ms, not 500");

	// -- the pattern player, which the reported scripts call ---------------
	mo.play_midi_chord_wait(chord, "arpeggio");
	check("arpeggio_held", true, "listened: the same note, laid out in time");

	mo.stop_all_notes();
	mo.close();

	say("Async wait test done. " + g_pass + " passed, " + g_fail + " failed.");
	print("PASS " + g_pass + " FAIL " + g_fail + "\n");
}
