#include "../midi.nvgt"

// test_async_wait.nvgt - the chord wait against the note wait, side by side.
//
// play_note_wait holds its note. play_chord_wait does not, on the same port in
// the same run. Both end in wait_until, so the difference is in the moment they
// pass it: play_note_wait adds group_length_at(sounding, tempo), and so does
// play_chord_wait.
//
// Every wait is measured with ticks(), the engine's millisecond clock, around
// the call. A call that returns at once (the bug this file exists for) reads
// as a few milliseconds and fails; a call that holds its length passes. The
// tolerance is 30 ms early and 150 ms late: ticks() on Windows moves in steps
// and the wait runs in 5 ms slices.
//
// The 400 ms comparison is built by hand rather than through music.nvgt: a bare
// note with its length in milliseconds, the same way the note above is written,
// so whatever separates them is not the unit. Then the same port with a tempo
// of 96 and a chord written as one beat - the shape music_quickstart uses, and
// the one that reported the bug - because a length in milliseconds survives any
// tempo while a length in beats does not.
//
// Last comes the pattern player. It had a second fault of its own: it released
// each note through its own channel, and a note whose length was written in
// beats could be let go on a channel the note on never used, which leaves a
// note ringing until it is clicked off. The trace at the end prints every note
// message the port sent.

int g_pass = 0;
int g_fail = 0;

string bstr(bool b) { if (b) return "true"; return "false"; }

void check(const string&in name, bool ok, const string&in detail) {
	string verdict = ok ? "PASS" : "FAIL";
	string line = "TEST " + name + " " + verdict + " " + detail;
	file_put_contents("apitest.log", line + "\n", true);
	print(line + "\n");
	if (ok) g_pass += 1;
	else g_fail += 1;
}

void say(const string&in text) {
	print(text + "\n");
	screen_reader_speak(text, false);
}

midi_output@ mo;

// Runs nothing itself: the caller reads ticks() before and after the call and
// hands the elapsed time here.
bool held(uint64 elapsed, double wanted) {
	return double(elapsed) >= wanted - 30.0 && double(elapsed) <= wanted + 150.0;
}

void main() {
	file_put_contents("apitest.log", "", false);
	say("Async wait test. Timing: note, chords, arpeggios and a scale, each against the clock.");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@mo = midi_output_create();
	if (!mo.open_config(config, "nvmidi async out")) {
		check("async_output_open", false, "cannot open an output: " + midi_last_error_text());
		print("PASS " + g_pass + " FAIL " + g_fail + "\n");
		return;
	}
	check("async_output_open", true, "opened " + midi_output_name_text(mo));

	// -- one note through play_note_wait, on a 400 ms note ----------------
	midi_note@ n = nvmidi_note_create(60, 100);
	n.length = midi_duration_create(400.0, MIDI_MS);
	check("note_length_reads_400", n.length.to_ms() > 399.0 && n.length.to_ms() < 401.0,
		"to_ms=" + n.length.to_ms());

	uint64 t = ticks();
	bool ok = mo.play_note_wait(n);
	uint64 note_took = ticks() - t;
	check("note_wait_held", ok && held(note_took, 400.0), "returned=" + bstr(ok) + " took " + note_took + " ms, wanted 400");

	// -- the same one note through play_chord_wait ------------------------
	// A length in milliseconds survives any port tempo; the chords written in
	// beats below do not, so both are here and whichever half is wrong says so.
	mo.tempo = 96.0;

	array<midi_note@>@ chord = array<midi_note@>();
	chord.insert_last(n);

	t = ticks();
	ok = mo.play_chord_wait(chord);
	uint64 chord_took = ticks() - t;
	check("chord_wait_held", ok && held(chord_took, 400.0), "returned=" + bstr(ok) + " took " + chord_took + " ms, wanted 400");

	// -- a chord written in beats, the shape music_quickstart uses ---------
	// A duration built with midi_duration_create carries the default tempo of
	// 120, so one beat reads 500 ms until a port at 96 resolves it to 625.
	// mo.duration() builds it at the port's tempo and reads 625 straight away.
	midi_note@ b = nvmidi_note_create(64, 100);
	b.length = midi_duration_create(1.0, MIDI_BEATS);
	check("beat_length_default_tempo", b.length.to_ms() > 499.0 && b.length.to_ms() < 501.0,
		"built at the default tempo of 120, to_ms=" + b.length.to_ms());
	midi_duration port_beat = mo.duration(1.0, MIDI_BEATS);
	check("beat_length_at_96", port_beat.to_ms() > 624.0 && port_beat.to_ms() < 626.0,
		"built by the port at 96, to_ms=" + port_beat.to_ms());

	array<midi_note@>@ beats = array<midi_note@>();
	beats.insert_last(b);
	t = ticks();
	ok = mo.play_chord_wait(beats);
	uint64 beat_took = ticks() - t;
	check("beat_chord_held", ok && held(beat_took, 625.0), "returned=" + bstr(ok) + " took " + beat_took + " ms, wanted 625 (not 500)");

	// -- the pattern player, which the reported scripts call ---------------
	t = ticks();
	ok = mo.play_midi_chord_wait(beats, "arpeggio");
	uint64 arp1_took = ticks() - t;
	check("arpeggio_held", ok && held(arp1_took, 625.0), "returned=" + bstr(ok) + " took " + arp1_took + " ms, wanted 625");

	// -- the music_quickstart shapes: a triad arpeggio and a scale ---------
	// The triad arpeggio steps every half length (312.5 ms) and the last note
	// is held a full beat: 2 * 312.5 + 625 = 1250 ms. The scale is eight
	// half-beat notes one after another: 8 * 312.5 = 2500 ms.
	array<midi_note@>@ triad = array<midi_note@>();
	int[] pitches = {60, 64, 67};
	for (uint i = 0; i < pitches.length(); i++) {
		midi_note@ tn = nvmidi_note_create(pitches[i], 100);
		tn.length = mo.duration(1.0, MIDI_BEATS);
		triad.insert_last(tn);
	}
	t = ticks();
	ok = mo.play_midi_chord_wait(triad, "arpeggio");
	uint64 arp3_took = ticks() - t;
	check("triad_arpeggio_held", ok && held(arp3_took, 1250.0), "returned=" + bstr(ok) + " took " + arp3_took + " ms, wanted 1250");

	array<midi_note@>@ scale = array<midi_note@>();
	for (int i = 0; i < 8; i++) {
		midi_note@ sn = nvmidi_note_create(60 + i * 2, 90);
		sn.length = mo.duration(0.5, MIDI_BEATS);
		scale.insert_last(sn);
	}
	t = ticks();
	ok = mo.play_sequence(scale);
	uint64 scale_took = ticks() - t;
	check("scale_sequence_held", ok && held(scale_took, 2500.0), "returned=" + bstr(ok) + " took " + scale_took + " ms, wanted 2500");

	mo.stop_all_notes();
	mo.close();

	say("Async wait test done. " + g_pass + " passed, " + g_fail + " failed.");
	print("PASS " + g_pass + " FAIL " + g_fail + "\n");
}
