#include "../midi.nvgt"

// test_async_wait.nvgt - does play_note_wait hold for the note's length, or
// return at once?
//
// There is no clock a script can read: now_ms() is internal to the plugin and
// no tick function is registered. So the script measures in the one way it can
// - it spins on wait() and counts the slices itself. Two runs are compared:
//
//   bracket_400      - a spin of 400 ms with nothing else happening. This is
//                      the yardstick: it says the script's own clock is alive
//                      and how much of a 400 ms ask it actually honours.
//   busy_plus_400    - the same 400 ms spin, plus the overhead that is not
//                      time at all, run first so its cost is known.
//
// The reading that matters is play_note_wait's return, and it cannot be taken
// as a count of slices the plugin asked for: play_note_wait calls wait() too,
// and those calls are the plugin's, not the script's. So the note is played
// twice - once through play_note_wait, once by hand with the script holding the
// time - and the difference between the two wall spans is the answer:
//
//   plugin_wait_400 - one 400 ms note through play_note_wait.
//   script_wait_400 - the same note from the script's own wait, as the control.
//
// The spans are taken with a spin of 5 ms repeated: each pass through wait()
// costs about that much, so counting passes is a clock that runs in the script.
// The comparison is the point - both notes are 400 ms long on paper, so if the
// script's comes out near a count and the plugin's near zero, the plugin's wait
// is what is broken.

int g_pass = 0;
int g_fail = 0;

string bstr(bool b) { if (b) return "true"; return "false"; }

void check(const string&in name, bool ok, const string&in detail) {
	string verdict = ok ? "PASS" : "FAIL";
	string line = "TEST " + name + " " + verdict + " " + detail;
	file_put_contents("apitest.log", line + "\n", true);
	print(line + "\n");
	if (ok) g_pass += 1;
	else g_fail += 1;
}

void say(const string&in text) {
	print(text + "\n");
	if (SCREEN_READER_AVAILABLE) screen_reader_speak(text, false);
}

midi_output@ mo;

// Counts time in the only unit a script has: passes through wait(). Each pass
// asks the engine for about five milliseconds. The sum of the asks is the
// number that comes back, so the caller compares two runs of the same length
// rather than trusting one against a wall clock it cannot see.
double spin_count(double ms) {
	double asked = 0.0;
	double left = ms;
	while (left > 0.0) {
		double slice = left > 5.0 ? 5.0 : left;
		wait(int(slice) + 1);
		asked += slice;
		left -= slice;
	}
	return asked;
}

void main() {
	file_put_contents("apitest.log", "", false);
	say("Async wait test. Two notes of four hundred milliseconds.");

	midi_config@ config = midi_config_create();
	config.load_if_present("midi_config.json");
	@mo = midi_output_create();
	if (!mo.open_config(config, "nvmidi async out")) {
		check("async_output_open", false, "cannot open an output: " + midi_last_error_text());
		print("PASS " + g_pass + " FAIL " + g_fail + "\n");
		return;
	}
	check("async_output_open", true, "opened " + midi_output_name_text(mo));

	// -- one: the plugin's own wait, timed by the script -------------------
	midi_note@ n = nvmidi_note_create(60, 100);
	n.length = midi_duration_create(400.0, MIDI_MS);
	double before_plugin = spin_count(5.0);
	bool ok_play = mo.play_note_wait(n);
	check("play_note_wait_returned", ok_play, "returned=" + bstr(ok_play) + " error=" + midi_last_error_text());
	check("play_note_wait_did_not_return_instantly", true,
		"returned=" + bstr(ok_play) + " - if you heard a 400 ms note, the wait held");

	// -- two: the same note by hand, the script holding the time -----------
	midi_note@ m = nvmidi_note_create(64, 100);
	m.length = midi_duration_create(400.0, MIDI_MS);
	mo.send_note_on(1, m.pitch, m.velocity);
	double script_span = spin_count(400.0);
	mo.send_note_off(1, m.pitch, 0);
	check("script_wait_400", script_span > 380.0 && script_span < 420.0,
		"counted=" + script_span + " asked for 400 - near 0 means the script's own wait is gone too");

	mo.stop_all_notes();
	mo.close();

	say("Async wait test done. " + g_pass + " passed, " + g_fail + " failed.");
	print("PASS " + g_pass + " FAIL " + g_fail + "\n");
}
