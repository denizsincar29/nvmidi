nvmidi.so
nvmidi.dll
*.o
*.so
*.dll
*.a
zig-cache/
.zig-cache/

# Build artefacts the CI job leaves behind
logs/
*.log
*.core
core

# Python bytecode left by running the ci helpers locally
__pycache__/
*.pyc

# Work in progress towards an alsa backend that reaches the sequencer
# through dlopen rather than a link-time dependency. Not shipped, and not
# something the repository should carry until it is.
scratch/

# MSVC build products (scripts/build_win_msvc.bat)
build-msvc/
*.exp
*.lib
*.pdb

# Packaged copies of the examples and tests, rebuilt by the release job.
# They are products, not sources: an update that ships them back in makes a
# fresh checkout of the tree, not of a build.
*.zip
loadcheck.nvgt

# The pinned engine, downloaded by scripts/nvgt_pin.sh into engine/ for local
# API probing. It is ~180 MB of prebuilt binaries, it is fetched on demand, and
# nothing in the repository needs it committed.
engine/

# A real config with the owner's own port numbers and port-name match.
# Examples read this file from the folder the engine runs in; the repository
# ships none, so a fresh checkout falls back to the first free ports.
examples/midi_config.json
