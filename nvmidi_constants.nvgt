// nvmidi_constants.nvgt - the numbers, with names.
//
// Include this instead of writing 0x90, 64 or 60 in a script. Every name here
// is an AngellScript `const`, which the compiler folds into the code, so a
// constant costs nothing at run time.
//
// The pitch names are note numbers in scientific pitch notation with middle C
// as C4 = 60. That is the spelling midi_note_number("C4") parses, so the
// constants and the string form agree.

// ---- note numbers ---------------------------------------------------------
//
// One octave in full, because that is the part people mistype, plus the two
// edges of the range. Every other pitch is NOTE_C4 + 12 * (octave - 4), or the
// plain number.

const int NOTE_LOWEST = 0;    // 0x00
const int NOTE_HIGHEST = 127; // 0x7f
const int NOTE_C4 = 60;       // middle C, the 128's midpoint below A440
const int NOTE_CS4 = 61;
const int NOTE_D4 = 62;
const int NOTE_DS4 = 63;
const int NOTE_E4 = 64;
const int NOTE_F4 = 65;
const int NOTE_FS4 = 66;
const int NOTE_G4 = 67;
const int NOTE_GS4 = 68;
const int NOTE_A4 = 69;       // the one at 440 Hz
const int NOTE_AS4 = 70;
const int NOTE_B4 = 71;
const int NOTE_C5 = 72;       // one octave up, to show the stride

// The offset between an octave number and the number of octaves above C-1:
// pitch = 12 * (octave + MIDI_OCTAVE_OFFSET) + degree. Named so a script
// generating notes does not hard-code the 1.
const int MIDI_OCTAVE_OFFSET = 1;

// ---- status bytes ---------------------------------------------------------
//
// The high nibble of the first byte of a message. A message from the plugin
// also answers `m.kind`, `m.is_note` and so on, so these are for a script that
// is building a message to send rather than reading one that arrived.

const int MIDI_NOTE_OFF = 0x80;
const int MIDI_NOTE_ON = 0x90;
const int MIDI_POLY_AFTERTOUCH = 0xa0;
const int MIDI_CONTROL_CHANGE = 0xb0;
const int MIDI_PROGRAM_CHANGE = 0xc0;
const int MIDI_CHANNEL_PRESSURE = 0xd0;
const int MIDI_PITCH_BEND = 0xe0;

// ---- controllers ----------------------------------------------------------

const int CC_BANK_SELECT = 0;
const int CC_MODULATION = 1;
const int CC_VOLUME = 7;
const int CC_PAN = 10;
const int CC_EXPRESSION = 11;
const int CC_SUSTAIN = 64;   // the damper pedal, on or off
const int CC_SOSTENUTO = 66; // the middle pedal
const int CC_SOFT_PEDAL = 67; // una corda, the left pedal
const int CC_ALL_NOTES_OFF = 123;

// The pedal_type a message reports, which is not the controller number: it is
// 1, 2 or 3 for the three pedals and 0 for everything else, so it fits in a
// switch without the script holding a table.

const int PEDAL_NONE = 0;
const int PEDAL_SUSTAIN = 1;
const int PEDAL_SOSTENUTO = 2;
const int PEDAL_SOFT = 3;

// ---- the data range -------------------------------------------------------

const int MIDI_MIN = 0;
const int MIDI_MAX = 127;
const int MIDI_PITCH_BEND_CENTER = 8192; // no bend: pitchbend answers this at rest
const int MIDI_PITCH_BEND_MAX = 16383;   // fully up; the bottom is 0
const int MIDI_CHANNELS = 16;

// ---- note name table ------------------------------------------------------
//
// PITCH_NAMES[degree] is the letter of a pitch class, degree being pitch % 12.
// The sharp spelling is the only one here; a script that wants flats can map
// them itself. Used like this:
//
//     screen_reader_speak(PITCH_NAMES[pitch % 12] + (pitch / 12 - 1));
//
// which is also what midi_note_pitch_text(pitch) does for you.

const string[] PITCH_NAMES = {
	"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"
};
